{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "sort_order": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "default": "Junglestar",
              "type": "string"
            }
          },
          "required": [
            "src"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "tags"
  ]
}