---
// @components/shared/LogoLinkBrandFull.astro
import Logo from "@components/shared/Logo.astro";
import * as siteData from "@data/site.json";
---

<style>
  .logo_link {
    transform: rotate(0deg);
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .brand {
    text-transform: uppercase;
    font-size: 150%;
    width: 100%;
  }
</style>

<a
  class="logo_link clean file_LogoLinkBrandFull"
  title="Clicking this link will send you back to junglestar.org homepage"
  href="/"
>
  <div class="brand center">
    <Logo />{siteData.brand_full}
  </div>
</a>
