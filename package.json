{
  "name": "junglestar",
  "type": "module",
  "version": "3.5.7",
  "private": true,
  "scripts": {
    "format": "biome format --write ./src",
    "lint": "biome lint ./src",
    "dev": "astro dev --open",
    "check": "astro check --watch & astro dev",
    "build": "astro build --force",
    "buildv": "astro build --verbose",
    "builddev": "astro build --devOutput",
    "buildwithtest": "astro check && tsc --noEmit && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "upg": "npx @astrojs/upgrade"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/ts-plugin": "^1.10.6",
    "@biomejs/biome": "^2.3.14",
    "astro": "^5.17.1",
    "prettier": "3.7.4",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@astro-community/astro-embed-link-preview": "^0.3.1"
  }
}
