{
  "name": "junglestar",
  "type": "module",
  "version": "4.1.2",
  "private": true,
  "scripts": {
    "format": "biome format --write ./src",
    "lint": "biome lint ./src",
    "clean": "rm -rf .astro dist node_modules/.vite",
    "covers": "node scripts/cache-covers.mjs",
    "prebuild": "node scripts/cache-covers.mjs",
    "dev": "rm -rf .astro && astro dev --open",
    "dev:clean": "pnpm clean && astro dev --open",
    "check": "astro check --watch & astro dev",
    "build": "find public -name '.DS_Store' -delete && astro build --force",
    "buildv": "astro build --verbose",
    "builddev": "astro build --devOutput",
    "buildwithtest": "astro check && tsc --noEmit && astro build",
    "preview": "astro preview",
    "deploy:cf": "pnpm build && wrangler deploy",
    "astro": "astro",
    "upg": "npx @astrojs/upgrade"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/ts-plugin": "^1.10.9",
    "@biomejs/biome": "^2.4.16",
    "astro": "^6.4.6",
    "astro-og-canvas": "^0.11.1",
    "canvaskit-wasm": "^0.41.1",
    "prettier": "3.7.4",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.99.0"
  },
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@astro-community/astro-embed-link-preview": "^0.3.1",
    "@bookbat/baobab": "link:../bookbat/packages/baobab",
    "@bookbat/library-core": "link:../bookbat/packages/library-core"
  }
}
