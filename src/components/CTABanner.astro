---
interface Props {
  email?: string;
  subject?: string;
  text?: string;
}

const {
  email = "info@junglestar.org",
  subject = "Send me more infos about Junglestar",
  text = "Let's start talking!",
} = Astro.props;
---

<style>
  .CTAbanner {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-block: 30dvh;
    text-transform: uppercase;
    a:hover {
      color: var(--white);
      background-color: var(--brand);
    }
  }
  @media (min-width: 600px) {
    .CTAbanner {
      padding-block: calc(var(--space_block) * 5);
    }
  }
</style>
<div class="CTAbanner">
  <a class="button CTAbutton" href={`mailto:${email}?subject=${encodeURIComponent(subject)}`}>
    {text}
  </a>
</div>
