---
import { render } from "astro:content";
import { Image } from "astro:assets";
import type { MDXPost } from "@utils/getMDXPosts";
import AnimatedCard from "@components/AnimateCardsCover.astro";

interface Props {
  posts: MDXPost<"designConcepts" | "productionConcepts">[];
}

const { posts } = Astro.props;
---

<div class="wrap margin_topx2 card_list">
  {
    posts.map(async (post) => {
      const { Content } = await render(post);
      return (
        <AnimatedCard end="33%" distance="33%" class:list={post}>
          <div id={post.id} class="hidden">
            &nbsp;
          </div>
          {post.data.image && (
            <div class="post_image">
              <Image src={post.data.image.src} alt={post.data.image.alt} />
            </div>
          )}
          <div class="post_header">
            <h3 class="post_title">{post.data.title}</h3>
            {post.data.subtitle && <p class="post_subtitle">{post.data.subtitle}</p>}
          </div>
          <div class="post_content">
            <Content />
          </div>
        </AnimatedCard>
      );
    })
  }
</div>
