---
// src/components/UI/AnimHeader2Black.astro|
// from BLACK to BRAND
import Logo from "@components/shared/Logo.astro";
import ScrollAni from "@components/UI/ScrollAni.astro";
---

<ScrollAni
  targetClass="header_scroll_ani"
  lumaInitial={0}
  lumaFinal={0.5286}
  chromaInitial={0.1735}
  chromaFinal={0.1735}
  hue="255deg"
  animationRange="0 1400px"
/>

<header
  slot="landing_screen"
  class="cover clickScrollTrigger header_scroll_ani file_AnimHeader2Brand"
>
  <Logo />
  <slot />
  <slot name="on_scroll_message" />
</header>
