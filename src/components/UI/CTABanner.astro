---
interface Props {
  email?: string;
  subject?: string;
  text?: string;
}

const {
  email = "info@junglestar.org",
  subject = "Send me more infos about Junglestar",
  text = "Let's start talking!",
} = Astro.props;
---

<style>
  .CTAMailBanner {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-block: 3rem;
    text-transform: uppercase;
  }
  @media (min-width: 600px) {
    .CTAMailBanner {
      padding-block: calc(var(--space_block) * 5);
    }
  }
</style>
<div class="CTAMailBanner">
  <a
    class="button"
    href={`mailto:${email}?subject=${encodeURIComponent(subject)}`}
  >
    {text}
  </a>
</div>
