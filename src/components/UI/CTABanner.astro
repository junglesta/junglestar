---
interface Props {
  link: string;
  title?: string;
  text: string;
  linkClass?: string;
}

const { link = "/", title = "back home", text = "J", linkClass } = Astro.props;
---

<style>
  .CTABanner {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-block: 3rem;
    text-transform: uppercase;
  }
  @media (min-width: 600px) {
    .CTABanner {
      padding-block: calc(var(--space_block) * 5);
    }
  }
</style>

<div class="CTABanner">
  <a class="${linkClass} cta button" title={title} href={link}>
    {text}
  </a>
</div>
