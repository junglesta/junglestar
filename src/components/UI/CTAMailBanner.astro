---
// CTAMailBanner.astro
import * as siteData from "@data/site.json";
import IconMail from "@svgs/mail.svg";

interface Props {
  email?: string;
  text?: string;
  linkClass?: string;
}

const {
  email = siteData.email,
  text = "Let's start talking!",
  linkClass = "transparent",
} = Astro.props;
---

<style>
  .CTAMailBanner {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-block: calc(var(--space_block) * 5);
    color: currentColor;
  }

  .CTAMailBanner .button {
    display: inline-flex;
    align-items: center;
    justify-content: space-evenly;
    gap: calc(var(--space_block) / 1);
    padding-inline: 15px 5px;
    font: inherit;
    font-weight: 400;
    text-transform: uppercase;
  }

  .CTAMailBanner .button svg {
    width: initial;
    height: initial;
    transition: transform 0.3s ease;
  }

  .CTAMailBanner .button:hover svg {
    transform: scaleX(-1);
  }
</style>

<div class="CTAMailBanner">
  <button
    class:list={[linkClass, "cta", "button"]}
    data-email={email}
    data-original-text={text}
    type="button"
  >
    <span>{text}</span>
    <IconMail width={35} height={35} stroke="currentColor" />
  </button>
</div>

<script>
  document
    .querySelectorAll(".CTAMailBanner button[data-email]")
    .forEach((button) => {
      button.addEventListener("click", async () => {
        const email = button.getAttribute("data-email");
        const originalText = button.getAttribute("data-original-text");
        const span = button.querySelector("span");

        if (!email || !span) return;

        try {
          await navigator.clipboard.writeText(email);
          span.textContent = "COPIED!";

          setTimeout(() => {
            span.textContent = originalText;
          }, 2000);
        } catch {
          // Show email if clipboard fails
          span.textContent = email;
        }
      });
    });
</script>
