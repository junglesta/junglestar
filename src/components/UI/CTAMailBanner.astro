---
// CTAMailBanner.astro
import * as siteData from "@data/site.json";
import IconMail from "@svgs/mail.svg";

interface Props {
  email?: string;
  subject?: string;
  text?: string;
  linkClass?: string;
}

const {
  email = siteData.email,
  subject = "Send me more infos about Junglestar",
  text = "Let's start talking!",
  linkClass = "transparent",
} = Astro.props;
---

<style>
  .CTAMailBanner {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-block: calc(var(--space_block) * 5);
    text-transform: uppercase;
  }

  .CTAMailBanner .button {
    display: inline-flex;
    align-items: center;
    justify-content: space-evenly;
    gap: calc(var(--space_block) / 1);
    padding-inline: 15px 5px;
  }

  .CTAMailBanner .button svg {
    width: initial;
    height: initial;
    transition: transform 0.3s ease;
  }

  .CTAMailBanner .button:hover svg {
    transform: scaleX(-1);
  }
</style>

<div class="CTAMailBanner">
  <a
    class:list={[linkClass, "cta", "button"]}
    href={`mailto:${email}?subject=${encodeURIComponent(subject)}`}
  >
    {text}
    <IconMail width={35} height={35} stroke="currentColor" />
  </a>
</div>
