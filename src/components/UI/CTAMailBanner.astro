---
// CTAMailBanner.astro
import * as siteData from "@data/site.json";
import IconMail from "@svgs/mail.svg";

interface Props {
  email?: string;
  subject?: string;
  text?: string;
  linkClass?: string;
}

const {
  email = siteData.email,
  subject = "Send me more infos about Junglestar",
  text = "Let's start talking!",
  linkClass = "transparent",
} = Astro.props;
---

<style>
  .CTAMailBanner {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-block: calc(--var(--space_block) * 3);
    text-transform: uppercase;
  }
  @media (min-width: 600px) {
    .CTAMailBanner {
      padding-block: calc(var(--space_block) * 5);
    }
  }

  .CTAMailBanner .button {
    display: inline-flex;
    align-items: center;
    justify-content: space-evenly;
    gap: calc(var(--space_block) / 1);
    padding-inline: 15px 5px;
  }
</style>
<div class="CTAMailBanner">
  <a
    class:list={[linkClass, "cta", "button"]}
    href={`mailto:${email}?subject=${encodeURIComponent(subject)}`}
  >
    {text}
    <IconMail size={12} stroke="currentColor" />
  </a>
</div>
