---
// ContactLinks.astro
import * as siteData from "@data/site.json";
import CTAMailLink from "@components/UI/CTAMailLink.astro";
import QRmodalLink from "@components/UI/QRmodalLink.astro";
---

<style>
  .contact_links {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    place-content: center;
    gap: calc(var(--space_block) / 2);
    padding: 0 !important;
    margin: 0 !important;
    .button {
      margin-block: 0;
    }
  }
</style>
<div class="contact_links">
  <CTAMailLink text="Mail" title="Get In Touch. Send us an email" />

  <a
    class="github footer_link"
    href={siteData.repo}
    title="we on Github"
    target="_blank"
    rel="noopener">Github</a
  >

  <QRmodalLink />
</div>
