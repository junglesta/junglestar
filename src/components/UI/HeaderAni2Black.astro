---
// src/components/UI/HeaderAni2Black.astro
import Logo from "@components/shared/LogoLink.astro";
import ScrollAni from "@components/UI/ScrollAni.astro";
---

<ScrollAni
  targetClass="header_scroll_ani"
  lumaInitial={0.5286}
  lumaFinal={0}
  chromaInitial={0.1735}
  chromaFinal={0}
  hue="255deg"
  animationRange="0dvh 200dvh"
/>

<div
  slot="landing_screen"
  class="cover jsScrollButton header_scroll_ani file_HeaderAni2Black"
>
  <Logo />
  <slot />
  <slot name="on_scroll_message" />
</div>
