---
// src/components/UI/HeaderAni2Black.astro|
// from BLACK to BRAND
import LogoAni from "@components/shared/LogoAni.astro";
import ScrollAni from "@components/UI/ScrollAni.astro";
---

<ScrollAni
  targetClass="header_astro"
  lumaInitial={0}
  lumaFinal={0.5286}
  chromaInitial={0.1735}
  chromaFinal={0.1735}
  hue="255deg"
  animationRange="0dvh 200dvh"
/>
<div
  slot="landing_screen"
  class="cover jsScrollButton header_astro _HeaderAni2Brand"
>
  <LogoAni />

  <div
    class="slogan"
    id="background_change_on_scroll_03"
  >
    <h1 class="space_between">
      <slot />
      <slot name="on_scroll_message" />
    </h1>
  </div>
</div>
