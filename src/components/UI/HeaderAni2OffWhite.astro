---
// src/components/UI/HeaderAni2OffWhite.astro
import LogoAni from "@components/shared/LogoAni.astro";
import ScrollAni from "@components/UI/ScrollAni.astro";
---

<ScrollAni
  targetClass="header_astro"
  lumaInitial={0.5286}
  lumaFinal={0.95}
  chromaInitial={0.1735}
  chromaFinal={0.01}
  hue="255deg"
  animationRange="0dvh 200dvh"
/>

<header
  slot="landing_screen"
  class="cover jsScrollButton header_astro _HeaderAni2OffWhite"
>
  <LogoAni />

  <div
    class="slogan"
    id="background_change_on_scroll_01"
  >
    <h1 class="space_between">
      <slot />
      <slot name="on_scroll_message" />
    </h1>
  </div>
</header>
