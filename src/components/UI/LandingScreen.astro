---
import Logo from "@components/brand/Logo.astro";
interface Props {
  overtitle_line1?: string;
  overtitle_line2?: string;
  overtitle_line3?: string;
  title?: string;
  onScroll_line1?: string;
  onScroll_line2?: string;
  onScroll_line3?: string;
  onScroll_line4?: string;
  onScroll_line5?: string;
  onScroll_line6?: string;
}

const {
  overtitle_line1 = "",
  overtitle_line2 = "",
  overtitle_line3 = "",
  title = "",
  onScroll_line1 = "",
  onScroll_line2 = "",
  onScroll_line3 = "",
  onScroll_line4 = "",
  onScroll_line5 = "",
  onScroll_line6 = "",
} = Astro.props;
---

<style>
  .icono {
    padding-block: var(--space_block);
    display: block;
    width: 200px;
    height: 200px;
    max-width: 25svw;
    svg {
      width: initial !important;
      height: initial !important;
    }
  }

  .huge {
    font-size: clamp(64px, 15svw, 99px);
    overflow: hidden;
    font-weight: clamp(200, 100, 100);
  }
</style>

<div class="grida pretty_heading wrap">
  <Logo />
  <h1 class="brand_name huge right clickScrollTrigger">{title}</h1>

  <div class="title_wrap h2 clickScrollTrigger">
    <div class="overline line1">{overtitle_line1}</div>
    <div class="overline line2">{overtitle_line2}</div>
    <div class="overline line3">{overtitle_line3}</div>
  </div>
  <div class="on_scroll_msg animatio h3 wrap">
    <div class="l1">{onScroll_line1.toUpperCase()}</div>
    <div class="l2">{onScroll_line2}</div>
    <div class="l3">{onScroll_line3}</div>
    <div class="icono">
      <slot />
    </div>
    <div class="l4">{onScroll_line4}</div>
    <div class="l5">{onScroll_line5}</div>
    <div class="l6">{onScroll_line6}</div>
  </div>
</div>
