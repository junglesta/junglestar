---
interface Props {
  overtitle_line1?: string;
  overtitle_line2?: string;
  overtitle_line3?: string;
  /** When passed, rendered as the page's <h1> in the hero. Pages whose <h1>
   *  comes from their own body content simply don't pass it. */
  title?: string;
  onScroll_line1?: string;
  onScroll_line2?: string;
  onScroll_line3?: string;
  onScroll_line4?: string;
  onScroll_line5?: string;
  onScroll_line6?: string;
}

const {
  overtitle_line1 = "",
  overtitle_line2 = "",
  overtitle_line3 = "",
  title = "",
  onScroll_line1 = "",
  onScroll_line2 = "",
  onScroll_line3 = "",
  onScroll_line4 = "",
  onScroll_line5 = "",
  onScroll_line6 = "",
} = Astro.props;
---

<div class="landing_height">
    <div class="landing_screen">
        <slot />

        {title && <h1>{title}</h1>}

        {overtitle_line1 && <p>{overtitle_line1}</p>}
        {overtitle_line2 && <p>{overtitle_line2}</p>}
        {overtitle_line3 && <p>{overtitle_line3}</p>}

        {onScroll_line1 && <p>{onScroll_line1}</p>}
        {onScroll_line2 && <p>{onScroll_line2}</p>}
        {onScroll_line3 && <p>{onScroll_line3}</p>}

        {onScroll_line4 && <p>{onScroll_line4}</p>}
        {onScroll_line5 && <p>{onScroll_line5}</p>}
        {onScroll_line6 && <p>{onScroll_line6}</p>}
    </div>
</div>

<style>
  /* Hero sits in the head region — colours are inherited (white-on-brand).
     Plain element selectors only; the markup stays class-free by design. */
  /* Portrait: one screen tall. Landscape: double-height hero. */
  .landing_height {
    height: 100svh;
  }

  @media (orientation: landscape) {
    .landing_height {
      height: 233svh;
    }
  }

  .landing_screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
    text-align: center;
    gap: calc(var(--space_block) / 2);
    padding-block: calc(var(--space_block) * 2);
    padding-inline: var(--space_inline);
    text-wrap: balance;
    position: sticky;
    top: 3rem;
  }

  .landing_screen h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3.75rem);
    line-height: 1.05;
  }

  .landing_screen p {
    margin: 0;
    max-width: 75ch;
    font-size: clamp(1.05rem, 2.4vw, 1.6rem);
    line-height: 1.3;
  }

  /* Slotted icon (passed by each page) — :global pierces the slot scope.
     Colour = the page master (= the banded h1 background / card borders), so
     the hero icon ties to the page's colour. Driven via `color` so it recolours
     both fill icons (fill="currentColor") and stroked icons (stroke below)
     uniformly. Home overrides this to the footer tint (see index.astro). */
  .landing_screen :global(svg) {
    width: clamp(255px, 40svw, 660px);
    height: auto;
    margin-block: var(--space_block);
    color: var(--brand);
    stroke: currentColor;
    stroke-width: var(--logo-stroke-icon, 0.37);
  }
</style>
