---
import Logo from "@components/brand/Logo.astro";
interface Props {
  overtitle_line1?: string;
  overtitle_line2?: string;
  overtitle_line3?: string;
  title?: string;
  onScroll_line1?: string;
  onScroll_line2?: string;
  onScroll_line3?: string;
  onScroll_line4?: string;
  onScroll_line5?: string;
  onScroll_line6?: string;
}

const {
  overtitle_line1 = "",
  overtitle_line2 = "",
  overtitle_line3 = "",
  title = "",
  onScroll_line1 = "",
  onScroll_line2 = "",
  onScroll_line3 = "",
  onScroll_line4 = "",
  onScroll_line5 = "",
  onScroll_line6 = "",
} = Astro.props;
---

<div class="grida pretty_heading">
  <Logo />
  <h1 class="brand_name right clickScrollTrigger">{title}</h1>

  <div class="title_wrap h2 clickScrollTrigger">
    <div class="overline line1">{overtitle_line1}</div>
    <div class="overline line2">{overtitle_line2}</div>
    <div class="overline line3">{overtitle_line3}</div>
  </div>
  <div class="on_scroll_msg h3 wrap">
    <div class="l1">{onScroll_line1.toUpperCase()}</div>
    <div class="l2">{onScroll_line2}</div>
    <div class="l3">{onScroll_line3}</div>

    <slot />

    <div class="l4">{onScroll_line4}</div>
    <div class="l5">{onScroll_line5}</div>
    <div class="l6">{onScroll_line6}</div>
  </div>
</div>
