---
import Logo from "@components/brand/Logo.astro";
interface Props {
  overtitle_line1?: string;
  overtitle_line2?: string;
  overtitle_line3?: string;
  title?: string;
  onScroll_line1?: string;
  onScroll_line2?: string;
  onScroll_line3?: string;
  onScroll_line4?: string;
  onScroll_line5?: string;
  onScroll_line6?: string;
}

const {
  overtitle_line1 = "",
  overtitle_line2 = "",
  overtitle_line3 = "",
  title = "",
  onScroll_line1 = "",
  onScroll_line2 = "",
  onScroll_line3 = "",
  onScroll_line4 = "",
  onScroll_line5 = "",
  onScroll_line6 = "",
} = Astro.props;
---

<style>
  .icono {
    padding-block: var(--space_block);
    display: block;
    width: 200px;
    height: 200px;
    max-width: 25svw;
    svg {
      width: initial !important;
      height: initial !important;
    }
  }

  .huge {
    font-size: clamp(55px, 15svw, 99px);
    overflow: hidden;
  }

  .grida {
    --row1: 30svh;
    --row2: 70svh;
    --row3: 200svh;
    height: calc(var(--row1) + var(--row2) + var(--row3));
    position: initial;
    display: grid;
    grid-template-rows: var(--row1) var(--row2) var(--row3);
    place-content: stretch center;
    gap: 2.5svh;

    padding-bottom: calc(var(--space_block) * 2);
    .brand_name {
      align-self: center;
      /*
      transform: rotate(-90deg);
      transform-origin: center -133%;
      */
    }
  }

  .grida > :first-child {
    align-self: start;
  }

  .grida > :nth-child(2) {
    align-self: start;
  }
  .grida > :nth-child(3) {
    align-self: center;
  }
</style>

<Logo variant="top" />
<div class="grida pretty_heading wrap">
  <h1 class="brand_name huge right clickScrollTrigger">{title}</h1>

  <div class="title_wrap h2 no_select">
    <div class="overline line1">{overtitle_line1}</div>
    <div class="overline line2">{overtitle_line2}</div>
    <div class="overline line3">{overtitle_line3}</div>
  </div>
  <div class="on_scroll_msg animatio h3 wrap no_select">
    <div class="l1">{onScroll_line1.toUpperCase()}</div>
    <div class="l2">{onScroll_line2}</div>
    <div class="l3">{onScroll_line3}</div>
    <div class="icono">
      <slot />
    </div>
    <div class="l4">{onScroll_line4}</div>
    <div class="l5">{onScroll_line5}</div>
    <div class="l6">{onScroll_line6}</div>
  </div>
</div>
