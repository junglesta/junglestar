---
interface Props {
  overtitle_line1?: string;
  overtitle_line2?: string;
  overtitle_line3?: string;
  title?: string;
  onScroll_line1?: string;
  onScroll_line2?: string;
  onScroll_line3?: string;
  onScroll_line4?: string;
  onScroll_line5?: string;
  onScroll_line6?: string;
}

const {
  overtitle_line1 = "",
  overtitle_line2 = "",
  overtitle_line3 = "",
  title,
  onScroll_line1 = "",
  onScroll_line2 = "",
  onScroll_line3 = "",
  onScroll_line4 = "",
  onScroll_line5 = "",
  onScroll_line6 = "",
} = Astro.props;
---

<div class="grida slogan">
  <div class="title_wrap h2">
    <div class="overline line1">{overtitle_line1}</div>
    <div class="overline line2">{overtitle_line2}</div>
    <div class="overline line3">{overtitle_line3}</div>
  </div>
  <h1 class="brand_name">{title}</h1>
  <h2 class="on_scroll_msg brand h3 wrap">
    {onScroll_line1.toUpperCase()}
    <br /><br />
    {onScroll_line2}
    <br /><br />
    {onScroll_line3}
    <br /><br />
    {onScroll_line4}
    <br /><br />
    {onScroll_line5}
    <br /><br />
    {onScroll_line6}
  </h2>
</div>
