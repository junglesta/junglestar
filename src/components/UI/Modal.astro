---
// Modal.astro
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<a href="#" class="modal_trigger center" data-modal={id}>
  <slot name="trigger" />
</a>

<dialog id={id}>
  <a href="#" class="close_modal" aria-label="Close">&times;</a>
  <slot />
</dialog>

<style>
  dialog {
      background-color: var(--black);
      color: var(--white);
    position: fixed;
    inset: 0;
    margin: auto;
    border: none;
    border-radius: var(--radius);
    padding: 5dvh 5dvw;
    width: calc(100svw - 10svw);
    height: calc(100svh - 10svh);
    max-width: min(calc(100svw - 10svw), 650px);
    max-height: min(calc(100svh - 10svh), 700px);
    overflow: auto;
  }

  dialog::backdrop {
    background: rgba(0, 0, 0, 1);
  }

  .close_modal {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    font-size: 1.5rem;
    text-decoration: none;
    line-height: 1;
  }
</style>

<script>
  function initModals() {
    document.querySelectorAll(".modal_trigger[data-modal]").forEach((trigger) => {
      const el = trigger as HTMLElement;
      // Avoid re-binding listeners when astro:page-load fires on persisted nodes.
      if (el.dataset.modalWired === "true") return;
      el.dataset.modalWired = "true";

      const modalId = el.dataset.modal;
      const dialog = document.getElementById(modalId!) as HTMLDialogElement;
      const closeBtn = dialog?.querySelector(".close_modal");

      trigger.addEventListener("click", (e) => {
        e.preventDefault();
        dialog?.showModal();
      });

      closeBtn?.addEventListener("click", (e) => {
        e.preventDefault();
        dialog.close();
      });

      dialog?.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });
    });
  }

  document.addEventListener("astro:page-load", initModals);
</script>
