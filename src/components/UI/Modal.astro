---
// Modal.astro
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<a href="#" class="modal_trigger center" data-modal={id}>
  <slot name="trigger" />
</a>

<dialog id={id}>
  <a href="#" class="close_modal" aria-label="Close">&times;</a>
  <slot />
</dialog>

<style>
  dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    border: none;
    border-radius: var(--radius);
    padding: 2rem;
    width: calc(100svw - 10svw);
    height: calc(100svh - 10svh);
    max-width: min(calc(100svw - 10svw), 800px);
    max-height: min(calc(100svh - 10svh), 600px);
    overflow: auto;
  }

  dialog::backdrop {
    background: rgba(255, 255, 255, 0.55);
  }

  .close_modal {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    font-size: 1.5rem;
    text-decoration: none;
    line-height: 1;
  }
</style>

<script>
  document.querySelectorAll(".modal_trigger[data-modal]").forEach((trigger) => {
    const modalId = (trigger as HTMLElement).dataset.modal;
    const dialog = document.getElementById(modalId!) as HTMLDialogElement;
    const closeBtn = dialog?.querySelector(".close_modal");

    trigger.addEventListener("click", (e) => {
      e.preventDefault();
      dialog?.showModal();
    });

    closeBtn?.addEventListener("click", (e) => {
      e.preventDefault();
      dialog.close();
    });

    dialog?.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>
