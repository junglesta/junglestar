    ></path>
  </svg>
  <div class="url">{url}</div>
</dialog>

<style>
  dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    border: none;
    border-radius: var(--radius);
    padding: 2rem;
    width: calc(100svw - 10svw);
    height: calc(100svh - 10svh);
    max-width: min(calc(100svw - 10svw), 400px);
    max-height: min(calc(100svh - 10svh), 450px);
    overflow: hidden;
    p {
      margin: 0;
    }
  }

  dialog::backdrop {
    background: rgba(255, 255, 255, 0.55);
  }

  dialog svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .url {
    text-align: center;
    margin: 1rem 0 0;
    user-select: all;
    font-family: monospace;
  }

  #close-modal {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    font-size: 1.5rem;
    text-decoration: none;
    line-height: 1;
  }
</style>

<script>
  const trigger = document.getElementById("qr-trigger");
  const modal = document.getElementById("qr-modal") as HTMLDialogElement;
  const closeBtn = document.getElementById("close-modal");

  trigger?.addEventListener("click", (e) => {
    e.preventDefault();
    modal?.showModal();
  });

  closeBtn?.addEventListener("click", (e) => {
    e.preventDefault();
    modal?.close();
  });

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) modal.close();
  });
</script>
