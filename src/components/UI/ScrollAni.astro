---
// ScrollAni.astro
interface Props {
  targetClass: string;
  lumaInitial: number;
  lumaFinal: number;
  chromaInitial: number;
  chromaFinal: number;
  hue: string;
  animationRange?: string;
  id?: string;
}

const {
  targetClass,
  lumaInitial,
  lumaFinal,
  chromaInitial,
  chromaFinal,
  hue,
  animationRange = "0 100%",
  id = targetClass.replace(/[^a-zA-Z0-9]/g, "_"),
} = Astro.props;
---

<style
  is:global
  set:html={`
  @property --luma-${id} {
    syntax: "<number>";
    initial-value: ${lumaInitial};
    inherits: false;
  }

  @property --chroma-${id} {
    syntax: "<number>";
    initial-value: ${chromaInitial};
    inherits: false;
  }

  @keyframes darken-${id} {
    to {
      --luma-${id}: ${lumaFinal};
      --chroma-${id}: ${chromaFinal};
    }
  }

  .${targetClass} {
    background: oklch(var(--luma-${id}) var(--chroma-${id}) ${hue});
    animation: darken-${id} linear;
    animation-timeline: scroll();
    animation-range: ${animationRange};
  }
`}
></style>
