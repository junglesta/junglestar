---
import type { MDXPost } from "@utils/getMDXPosts";
import { slugify } from "@utils/slugify";

interface Props {
  posts: MDXPost<"designConcepts" | "productionConcepts">[];
  basePath: string;
  title?: string;
}

const { posts, basePath, title = "Table of Contents" } = Astro.props;
---

<div class="wrap">
  <div class="toc max_width_60ch">
    <div class="h4">{title}</div>
    <ul>
      {
        posts.map((post) => (
          <li>
            <a href={`/${basePath}/${slugify(post.data.title)}`}>
              <span>{post.data.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
