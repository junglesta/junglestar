---
import type { MDXPost } from "@utils/getMDXPosts";

interface Props {
  posts: MDXPost<"designConcepts" | "productionConcepts">[];
  title?: string;
}

const { posts, title = "Table of Contents" } = Astro.props;
---

<div class="wrap">
  <div class="toc max_width_60ch">
    <div class="h4">{title}</div>
    <ul>
      {
        posts.map((post) => (
          <li>
            <a href={`#${post.id}`}>
              <span>{post.data.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
