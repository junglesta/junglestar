---
// @component/Gmap.astro
import CTAMailBanner from "@components/UI/CTAMailBanner.astro";
import Pin from "@svgs/gmap_pin.svg";
import Tienda from "@svgs/gmap_tienda.svg";
---

<style>
  .mean_icon,
  .mean_icon > * {
    color: var(--white);
  }

  .mean_title .wrap {
      padding-inline: calc(var(--space_inline) * 2);
  }

  /* The three checklists: centred column, centred text, even rhythm between
     groups. Inside markers keep the ✓ centred with each line. Overrides
     selling.css. */
  .what.selling_gmap {
    max-width: 34rem;
    margin-inline: auto;
    padding: 0 var(--space_inline) calc(var(--space_block) * 4);
    text-align: center;
  }

  .what.selling_gmap h4 {
    margin: 0 0 calc(var(--space_block) / 4);
  }

  .what.selling_gmap h4:not(:first-child) {
    margin-top: var(--space_block);
  }

  /* Headings stay centred; the lists are full-width blocks of the centred
     column, so all three share one width and one left edge. */
  .what.selling_gmap ul {
    margin: 0;
    padding-left: 1.4em;
    text-align: left;
    list-style-position: outside;
  }

  .what.selling_gmap li {
    margin-block: calc(var(--space_block) / 8);
  }
</style>

<section class="gmap">
  <header>
    <div class="offer_content google_map">
      <div
        class="mean_title mean_title--first flex flex_cols flex_align_center flex_justify_center no_select"
      >
        <div class="mean_icon">
          <Pin width={255} height={255} fill="none" stroke="currentColor" />
        </div>
        <div class="wrap">
          <h2 class="h1 center pretty">Want more customers finding your location?</h2>
        </div>
      </div>

      <div
        class="mean_title mean_title--second flex flex_cols flex_align_center flex_justify_center"
      >
        <div class="mean_icon">
          <Tienda width={255} height={255} fill="none" stroke="currentColor" />
        </div>
        <div class="wrap">
          <h2 class="center pretty">We make sure your shop shows up online.</h2>

          <h3 class="h5 center">
            We feed the map so your Restaurant / Shop / SmallBiz shows up when people search for something nearby.
          </h3>
        </div>

        <div class="wrap what selling_gmap">
          <h4>WHAT WE DO</h4>

          <ul class="do">
            <li>Set up your Business Profile properly.</li>
            <li>Phone number, hours, location, products</li>
            <li>Upload a few photos, maybe a video or two</li>
            <li>
              Basically everything people need to find you and know you're open.
            </li>
          </ul>

          <h4>WHAT YOU GET</h4>

          <ul class="get">
            <li>Your business on Google Maps.</li>
            <li>The contacts, visits, enqueries that derive from it.</li>
            <li>A simple one-page website.</li>
            <li>A micro blog if you want it.</li>
            <li>Guidance.</li>
          </ul>

          <h4>THEN YOU CAN</h4>

          <ul class="can">
            <li>Get to know more about who's looking for you.</li>
            <li>Update hours & specials from your phone via the Maps app.</li>
            <li>Post photos & news about new products or holiday hours.</li>
            <li>
              Do it all yourself or give access to others. No password sharing
              needed!
            </li>
          </ul>
        </div>

        <CTAMailBanner text="Want the details?" />
      </div>
    </div>
  </header>
</section>
