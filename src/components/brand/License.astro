---
// @components/brand/License.astro
//
import * as siteData from "@data/site.json";
import CCico1 from "@svgs/cc_icon1.svg";
import CCico2 from "@svgs/cc_icon2.svg";
import CCico3 from "@svgs/cc_icon3.svg";
import CCicoNC from "@svgs/cc_icon_nc.svg";
---

<style>
  .cc_icons {
    svg {
      width: 24px;
      height: 24px;
    }
  }
  .head {
    font-size: 111%;
  }
</style>

<div class="license">
  <div class="head">License</div>
  <div class="cc_icons">
    <CCico1 />
    <CCico2 />
    <CCicoNC />
    <CCico3 />
  </div>
  <div>
    This website <a
      target="_blank"
      rel="noopener"
      href={siteData.repo}
    >
      <strong>source code</strong>
    </a> is owned by {siteData.brand} and it's licensed under <a
      target="_blank"
      rel="noopener"
      href={siteData.license_url}
    >
      Creative Commons <strong>CC BY-NC-SA 4.0</strong>
    </a>
  </div>
</div>
