---
// @components/brand/Logo.astro
import LogoSVG from "@assets/svgs/logo_stroke.svg";

export interface Props {
  variant: "top" | "bottom";
}

const { variant } = Astro.props;
---

<style>
  :root {
    --logo_size: 255px;
  }

  /* Mobile */
  @media (max-width: 768px) {
    :root {
      --logo_size: 160px;
    }
  }
  .logo_link {
    padding-top: var(--space_block);
    color: currentColor;
    position: relative;
    display: block;
    align-self: end;
  }
  .logo_link::after,
  .logo_link::before {
    content: "";
    display: none;
  }

  .logosvg {
    color: currentColor;
    width: var(--logo_size);
  }

  .logo_link_top {
    bottom: 0;
    display: grid;
    place-content: center;
  }

  .logo_link_bottom {
    bottom: 0;
    display: grid;
    place-content: center;
  }

  /* Landscape phones: hide top logo */
  @media (orientation: landscape) and (max-height: 500px) {
    .logo_link_top {
      display: none;
    }
  }
</style>

<a
  class={`logo_link logo_link_${variant}`}
  title="This link goes back to junglestar.org homepage"
  href="/"
>
  <LogoSVG class="logosvg" width={255} height={255} fill="currentColor" />
</a>
