---
// @components/brand/Logo.astro
import LogoSVG from "@assets/svgs/logo_stroke.svg";
---

<style>
  .logo_link {
    display: grid;
    place-content: center;
    text-decoration: none;
    color: currentColor;
  }

  .logo_link::after,
  .logo_link::before {
    content: "";
    display: none;
  }

  .logosvg {
    color: currentColor;
  }
</style>

<a
  class="logo_link file_Logo"
  title="This link goes back to junglestar.org homepage"
  href="/"
>
  <LogoSVG class="logosvg" width={555} height={555} fill="currentColor" />
</a>
