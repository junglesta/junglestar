---
// @components/brand/Logo.astro
import LogoSVG from "@assets/svgs/logo_stroke.svg";
---

<style>
  .logo_link {
    display: grid;
    place-content: center;
    text-decoration: none;
    color: currentColor;
    /* Responsive logo size - same everywhere */
    width: var(--logo-size, 220px);
    max-width: 100%;
    margin-inline: auto;
  }

  .logo_link::after,
  .logo_link::before {
    content: "";
    display: none;
  }

  .logosvg {
    color: currentColor;
    width: 100%;
    height: auto;
  }

  /* Landscape - constrain logo by height to fit grid row */
  @media (min-aspect-ratio: 4/3) {
    .logo_link {
      width: auto;
      max-height: 30svh;
    }

    .logosvg {
      width: auto;
      height: 30svh;
    }
  }
</style>

<a
  class="logo_link file_Logo"
  title="This link goes back to junglestar.org homepage"
  href="/"
>
  <LogoSVG class="logosvg" width={555} height={555} fill="currentColor" />
</a>
