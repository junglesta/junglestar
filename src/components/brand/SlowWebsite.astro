---
//SlowWebsite.astro
//import CTAMailBanner from "@components/UI/CTAMailBanner.astro";
import Desperate from "@svgs/desperate.svg";
import Jumping from "@svgs/jumping.svg";
---

<div class="scrolltarget slow_website">
  <div class="mean_title mean_title--first">
    <div class="wrap flex flex_cols flex_align_center flex_justify_center">
      <div class="mean_icon desperate">
        <Desperate fill="currentColor" width="200" />
      </div>

      <h1 class="center">Is your website slow?</h1>
      <h2 class="h3 center">
        Do I need to pinch & zoom a PDF to see your pricelist?
      </h2>
    </div>
  </div>

  <div class="mean_title mean_title--second">
    <div class="wrap flex flex_cols flex_align_center flex_justify_center">
      <div class="mean_icon jumping">
        <Jumping fill="currentColor" width="200" />
      </div>

      <h1 class="center">We can fix that.</h1>
      <note class="center">
        Not all design services actually take care of their customers past
        onboarding. Some, just shamlessly cash & dash. Then you change supplier.
      </note>
      <h2 class="h3 center">
        We've been helping small companies kickstart their first websites since
        day one.
      </h2>
    </div>
  </div>

  <slot />
</div>
