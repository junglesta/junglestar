---
//SocialMediaManagement.astro
import CTAMailBanner from "@components/UI/CTAMailBanner.astro";
import IG from "@svgs/svg_brands/instagram.svg";
import TT from "@svgs/svg_brands/tiktok.svg";
import F from "@svgs/svg_brands/facebook.svg";
import Share from "@svgs/share.svg";
import YT from "@svgs/svg_brands/youtube.svg";

export interface Props {
  dominantColor?: string;
}

const { dominantColor = "--brand" } = Astro.props;
---

<style>
  .brand_light {
    background-color: var(--brandT25);
  }
  .mean_icon {
    color: var(--brand);
  }
</style>
<div
  class="offer_content light_bg page_break social_media_management brand_light relative"
>
  <div class="mean_title mean_title--first">
    <div class="wrap flex flex_cols flex_align_center flex_justify_center">
      <div class="mean_icon">
        <Share fill="none" width="200" />
      </div>
      <h2 class="center brand">Social media power for your brand?</h2>
    </div>
  </div>

  <div class="mean_title mean_title--second">
    <div class="wrap flex flex_cols flex_align_center flex_justify_center">
      <div class="mean_icon four_icon_group">
        <IG fill="currentColor" width="200" height="200" />
        <TT fill="currentColor" width="200" height="200" />
        <F fill="currentColor" width="200" height="175" />
        <YT fill="currentColor" width="200" height="200" />
      </div>

      <div class="flex-wrap-reverse">
        <h2 class="h1 center">
          We build your image through social engagement!
        </h2>
        <h3 class="h2 center">
          Instagram, TikTok, YouTube, Facebook, LinkedIn, GoogleMap...
        </h3>
        <ul>
          <li>First we strategize goals & audience together, then...</li>

          <li>
            We'll target and engage <strong> real active users. </strong>
          </li>
          <li>We'll build your brand, authentically growing your audience.</li>
          <li>
            We'll direct traffic to your site/shop <br />leveraging the smartest
            tools for thought and platform dynamics.
          </li>
        </ul>
      </div>
    </div>

    <!-- <div class="space_block">&nbsp;</div> -->

    <CTAMailBanner />
  </div>
</div>
