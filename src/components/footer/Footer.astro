---
// src/components/footer/Footer.astro
import Carbon from "@components/brand/Carbon.astro";
import Contactlinks from "@components/UI/ContactLinks.astro";
import License from "@components/brand/License.astro";
import Logo from "@components/brand/Logo.astro";
import Nav from "@components/shared/Nav.astro";
import Modal from "@components/UI/Modal.astro";
import * as siteData from "@data/site.json";

const currentYear = new Date().getFullYear();

// .bg_brand
// .bg_white
// .bg_black
---

<style>
  .footer_wrap {
    width: 100%;
    min-height: 100svh;
    margin-top: calc(var(--space_block) * 5);
    padding-top: var(--space_block);
    padding-bottom: 0;
    color: inherit;
    display: grid;
    place-content: center;
    gap: var(--space_inline);

    color: currewntColor;
    a:not(.footer_logo):not(.no_underline) {
      color: inherit;
      text-decoration-thickness: 2px;
    }

    a:hover {
      color: inherit;
    }
  }

  .copy {
    text-align: center;
  }
  .logo_link_wrap {
    max-width: 250px;
    margin-inline: auto;
  }
</style>

<footer class="footer_wrap footer_site">
  <div class="logo_link_wrap">
    <Logo />
  </div>
  <Contactlinks />
  <Nav />

  <Modal id="brand-details">
    <span slot="trigger">
      &copy; 2012-{currentYear}
      {siteData.brand}.org <span>&nbsp;+</span>
    </span>

    <Carbon />
    <License />
  </Modal>
</footer>
