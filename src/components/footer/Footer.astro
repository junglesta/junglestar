---
import Carbon from "@components/UI/Carbon.astro";
import Contactlinks from "@components/UI/ContactLinks.astro";
import License from "@components/brand/License.astro";
import Logo from "@components/shared/LogoFull.astro";
import Nav from "@components/shared/Nav.astro";
// src/components/footer/Footer.astro
import * as siteData from "@data/site.json";

const currentYear = new Date().getFullYear();
---

<style>
  .footer_wrap {
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
  }
  .footer_site {
    width: 100%;
    min-height: var(--viewport_height);
    padding-top: var(--space_block);
    padding-bottom: calc(var(--space_block) / 2);
    padding-inline: var(--space_inline);
    color: var(--white);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: start;
    position: sticky;
    bottom: 0;

    a:not(.footer_logo):not(.no_underline) {
      color: var(--link_color);
      text-decoration-thickness: 2px;
    }

    a:hover {
      color: var(--link_color_hover);
    }
  }

  .details_body {
    font-size: calc(var(--font_clamp) * 0.88);
    max-width: 31ch;
    width: fit-content;
    margin: 0 auto;
  }
  details {
    background-color: var(--brand);
  }
  summary {
    text-align: center;
  }
</style>

<footer class="footer_site">
  <Logo />
  <div class="footer_wrap">
    <Contactlinks />
    <Nav />

    <details class="">
      <summary class="copy">
        &copy; 2012-{currentYear}
        {siteData.brand}.org
      </summary>
      <div class="details_body pretty">
        <Carbon />
        <License />
      </div>
    </details>
  </div>
</footer>
