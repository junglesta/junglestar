---
// src/components/footer/Footer.astro
import Carbon from "@components/UI/Carbon.astro";
import Contactlinks from "@components/UI/ContactLinks.astro";
import License from "@components/brand/License.astro";
import Logo from "@components/brand/Logo.astro";
import Nav from "@components/shared/Nav.astro";
import * as siteData from "@data/site.json";

const currentYear = new Date().getFullYear();

// .bg_brand
// .bg_white
// .bg_black
---

<style>
  .footer_wrap {
    width: 100%;
    min-height: var(--viewport_height);
    padding-top: var(--space_block);
    padding-bottom: 0;
    padding-inline: var(--space_inline);
    color: inherit;
    display: grid;
    place-content: center;
    gap: var(--space_inline);

    color: currewntColor;
    a:not(.footer_logo):not(.no_underline) {
      color: inherit;
      text-decoration-thickness: 2px;
    }

    a:hover {
      color: inherit;
    }
  }

  .footer_site {
    display: grid;
    place-content: center;
    gap: var(--space_inline);
    padding-bottom: 1rem;
    margin-top: calc(var(--space_block) * 5);
  }
  .copy {
    text-align: center;
  }
</style>

<footer class="footer_wrap footer_site">
  <Logo />
  <Contactlinks />
  <Nav />

  <details class="">
    <summary class="copy">
      &copy; 2012-{currentYear}
      {siteData.brand}.org
    </summary>
    <div class="details_reveal pretty">
      <Carbon />
      <License />
    </div>
  </details>
</footer>
