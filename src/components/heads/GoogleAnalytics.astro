---
// src/components/heads/GoogleAnalytics.astro
import * as siteData from "@data/site.json";

const gaId = siteData.google.analytics;
// Only fire on Netlify production context — excludes dev, deploy-previews, branch builds.
const isNetlifyProduction = process.env.CONTEXT === "production";
const enabled = isNetlifyProduction && Boolean(gaId);
---

{enabled && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
)}
