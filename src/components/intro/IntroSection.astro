---
import { getCollection } from "astro:content";
import CTABanner from "@components/UI/CTABanner.astro";
// import Wave from "@components/UI/Wave.astro";
const introItems = await getCollection("introJ");
const svgRaw = import.meta.glob("/src/assets/intro/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

function getSvgRaw(jsonPath: string) {
  const srcPath = `/src${jsonPath}`;
  return svgRaw[srcPath] || "";
}

function parseBold(text: string) {
  return text.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
}

// Generate unique ID for clip-path
const clipId = `wave_${Math.random().toString(36).slice(2, 9)}`;
// waveHeight?: number; // 0-1, where the wave starts (default 0.7 = 70% from top)
const waveHeight = 0.9;
// Build wave path with configurable height
const wavePath = `M0,0 L1,0 L1,${waveHeight} Q0.75,${waveHeight + 0.15} 0.5,${waveHeight} Q0.25,${waveHeight - 0.15} 0,${waveHeight} Z`;

const topBackground = "var(--black)";
---

<style>
  .intro_memes {
    margin: 0 auto;
    padding-block: calc(var(--space_block) * 5);
  }

  .intro_meme {
    padding-block: clamp(2rem, 12svh, 8rem);
  }

  .intro_content {
    text-align: left;
    position: relative;
    z-index: 1;
    margin: 0 auto;
    max-width: 60ch;
    padding-block: var(--space_block);
  }

  .background_svg {
    pointer-events: none;
    z-index: 0;
    transform: scale(1.75);
    transform-origin: bottom center;
  }

  @media (370px < width) {
    .background_svg {
      transform: scale(1.75);
    }
  }

  @media (600px < width) {
    .background_svg {
      transform: scale(1.5);
    }
  }

  @media (800px < width) {
    .background_svg {
      transform: scale(1.35);
    }
  }

  @media (10240px < width) {
    .background_svg {
      transform: scale(1.15);
    }
  }

  .background_svg :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
  /* Homogenised body text — one size, weight & line-height; bold kept via <strong> */
  .intro_content p {
    font-size: var(--font_clamp);
    line-height: 1.5;
    font-weight: var(--weight);
    margin-block: var(--space_block);
  }

  /* Intro sits in the near-white main region → dark body text,
     brand colour kept for emphasis via headings/<strong>. */
  .intro_memes {
    color: var(--fg_main);
  }
</style>

<section class="intro_memes">
  <div class="relative">
    {
      introItems.map((item) => (
        <article class="intro_meme wrap " data-theme={item.data.theme}>
          <div
            class="background_svg animatio_slide_pulse"
            set:html={getSvgRaw(item.data.image.src)}
          />
   <div class="intro_content ">
          <h2 class="h2" set:html={parseBold(item.data.title1)} />
          <p set:html={parseBold(item.data.sub1)} />
          <h3 class="h2" set:html={parseBold(item.data.title2)} />
          <p set:html={parseBold(item.data.sub2)} />
            {item.data.p1 && <p set:html={parseBold(item.data.p1)} />}
            {item.data.p2 && <p set:html={parseBold(item.data.p2)} />}
            {item.data.p3 && <p set:html={parseBold(item.data.p3)} />}
            {item.data.p4 && <p set:html={parseBold(item.data.p4)} />}
            {item.data.p5 && <p set:html={parseBold(item.data.p5)} />}
            {item.data.p6 && <p set:html={parseBold(item.data.p6)} />}

            <CTABanner
              text={item.data.cta}
              link={item.data.link}
              linkClass={item.data.theme}
            />
          </div>
        </article>
      ))
    }
  </div>
</section>
