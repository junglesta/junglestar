---
import { getCollection } from "astro:content";
import CTABanner from "@components/UI/CTABanner.astro";
import Wave from "@components/UI/Wave.astro";
const introItems = await getCollection("introJ");
const svgRaw = import.meta.glob("/src/assets/intro/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

function getSvgRaw(jsonPath: string) {
  const srcPath = `/src${jsonPath}`;
  return svgRaw[srcPath] || "";
}

function parseBold(text: string) {
  return text.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
}
---

<style>
  .intro_memes {
    /*max-width: 60ch;*/
    margin: 0 auto;
    padding-block: calc(var(--space_block) * 5);
    text-align: center;
  }
  .intro_meme {
    padding-block: calc(var(--space_block) * 8);
  }

  .intro_memes:first-child {
    padding-block-start: 0;
  }
  .intro_memes:last-child {
    padding-block-end: 0;
  }

  .content {
    text-align: left;
    position: relative;
    z-index: 1;
    margin: 0 auto;
    max-width: 60ch;
  }

  .background_svg {
    pointer-events: none;
    z-index: 0;
    transform: scale(1.75);
    transform-origin: bottom center;
  }

  @media (370px < width) {
    .background_svg {
      transform: scale(1.75);
    }
  }

  @media (600px < width) {
    .background_svg {
      transform: scale(1.5);
    }
  }

  @media (800px < width) {
    .background_svg {
      transform: scale(1.35);
    }
  }

  @media (10240px < width) {
    .background_svg {
      transform: scale(1.15);
    }
  }

  .background_svg :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
  .tagline {
    text-align: center;
    line-height: 1.1;
  }

  .intro_memes {
    color: var(--brand);
    p {
      padding-top: var(--space_block);
      border-bottom: 1px solid var(--brand_light);
      padding-bottom: var(--space_block);
    }

    details[open] summary {
      border-bottom: 1px solid var(--brand_light);
    }

    details summary::after {
      display: block;
      padding-top: var(--space_block);
    }
  }

  .wave.bottom {
    background-color: var(--color);
  }
</style>

<Wave
  color="var(--black)"
  position="top"
/>

<section class="intro_memes txt_white_on_black">
  {
    introItems.map((item) => (
      <article
        class="intro_meme wrap"
        data-theme={item.data.theme}
      >
        <div
          class="background_svg"
          set:html={getSvgRaw(item.data.image.src)}
        />

        <h1 class="h2 brand">{item.data.question}</h1>

        <h2 class="h4 offwhite">{item.data.title}</h2>
        <h3 class="h5 offwhite">{item.data.subtitle}</h3>
        <div class="content offwhite">
          <details>
            <summary class="tagline">{item.data.tagline}</summary>
            {item.data.p1 && <p set:html={parseBold(item.data.p1)} />}
            {item.data.p2 && <p set:html={parseBold(item.data.p2)} />}
            {item.data.p3 && <p set:html={parseBold(item.data.p3)} />}
            {item.data.p4 && <p set:html={parseBold(item.data.p4)} />}
            {item.data.p5 && <p set:html={parseBold(item.data.p5)} />}
            {item.data.p6 && <p set:html={parseBold(item.data.p6)} />}

            <CTABanner
              text={item.data.cta}
              link={item.data.link}
              linkClass={item.data.theme}
            />
          </details>
        </div>
      </article>
    ))
  }
</section>
