---
import { getCollection } from "astro:content";
import CTABanner from "@components/UI/CTABanner.astro";
// import Wave from "@components/UI/Wave.astro";
const introItems = await getCollection("introJ");
const svgRaw = import.meta.glob("/src/assets/intro/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

function getSvgRaw(jsonPath: string) {
  const srcPath = `/src${jsonPath}`;
  return svgRaw[srcPath] || "";
}

function parseBold(text: string) {
  return text.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
}
---

<style>
  .intro_memes {
    margin: 0 auto;
    padding-block: calc(var(--space_block) * 8);
  }

  .intro_meme {
    padding-block: calc(var(--space_block) * 8);
  }

  .intro_content {
    text-align: left;
    position: relative;
    z-index: 1;
    margin: 0 auto;
    max-width: 60ch;
  }

  .background_svg {
    pointer-events: none;
    z-index: 0;
    transform: scale(1.75);
    transform-origin: bottom center;
  }

  @media (370px < width) {
    .background_svg {
      transform: scale(1.75);
    }
  }

  @media (600px < width) {
    .background_svg {
      transform: scale(1.5);
    }
  }

  @media (800px < width) {
    .background_svg {
      transform: scale(1.35);
    }
  }

  @media (10240px < width) {
    .background_svg {
      transform: scale(1.15);
    }
  }

  .background_svg :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
  .tagline {
    line-height: 1.1;
    padding-bottom: var(--space_block);
  }

  .intro_memes {
    color: var(--brand);
    p {
      padding-top: calc(var(--space_block) / 4);
    }

    details summary::after {
      display: block;
      padding-top: var(--space_block);
    }
    details[open] summary {
      padding-bottom: calc(var(--space_block) * 5);
      border-bottom: 0 none;
    }
  }

  .txt_white_on_black > * {
    color: var(--white);
  }

  .cta.button.superstition {
    color: red;
  }
</style>

<section class="intro_memes txt_white_on_black">
  <div class="relative">
    {
      introItems.map((item) => (
        <article class="intro_meme wrap " data-theme={item.data.theme}>
          <div
            class="background_svg animatio_slide_pulse"
            set:html={getSvgRaw(item.data.image.src)}
          />

          <h1 class="h2 ">{item.data.question}</h1>
          <h2 class="h4 ">{item.data.title}</h2>
          <h3 class="h5 ">{item.data.subtitle}</h3>

          <div class="intro_content ">
            <details>
              <summary class="tagline">{item.data.tagline}</summary>
              {item.data.p1 && <p set:html={parseBold(item.data.p1)} />}
              {item.data.p2 && <p set:html={parseBold(item.data.p2)} />}
              {item.data.p3 && <p set:html={parseBold(item.data.p3)} />}
              {item.data.p4 && <p set:html={parseBold(item.data.p4)} />}
              {item.data.p5 && <p set:html={parseBold(item.data.p5)} />}
              {item.data.p6 && <p set:html={parseBold(item.data.p6)} />}

              <CTABanner
                text={item.data.cta}
                link={item.data.link}
                linkClass={item.data.theme}
              />
            </details>
          </div>
        </article>
      ))
    }
  </div>
</section>
