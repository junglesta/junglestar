---
import { getCollection } from "astro:content";
//import CTAMailBanner from "@components/UI/CTAMailBanner.astro";
const introItems = await getCollection("introJ");
const svgRaw = import.meta.glob("/src/assets/intro/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

function getSvgRaw(jsonPath: string) {
  const srcPath = `/src${jsonPath}`;
  return svgRaw[srcPath] || "";
}

function parseBold(text: string) {
  return text.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
}
---

<section class="intro_memes">
  {
    introItems.map((item) => (
      <article
        class="intro_meme"
        data-theme={item.data.theme}
      >
        <div
          class="background_svg"
          set:html={getSvgRaw(item.data.image.src)}
        />

        <h1 class="h3 brand">{item.data.question}</h1>
        <h2 class="h4">{item.data.title}</h2>
        <h3 class="h5">{item.data.subtitle}</h3>
        <div class="content">
          <details>
            <summary class="tagline">{item.data.tagline}</summary>
            {item.data.p1 && <p set:html={parseBold(item.data.p1)} />}
            {item.data.p2 && <p set:html={parseBold(item.data.p2)} />}
            {item.data.p3 && <p set:html={parseBold(item.data.p3)} />}
            {item.data.p4 && <p set:html={parseBold(item.data.p4)} />}
            {item.data.p5 && <p set:html={parseBold(item.data.p5)} />}
            {item.data.p6 && <p set:html={parseBold(item.data.p6)} />}

            <a
              href={item.data.link}
              class="cta"
            >
              {item.data.cta}
            </a>
          </details>
        </div>
      </article>
    ))
  }
</section>

<style>
  .intro_memes {
    padding-inline: calc(var(--space_block) * 2);
    /*max-width: 60ch;*/
    margin: 0 auto;
    padding-block: calc(var(--space_block) * 5);
    text-align: center;
  }
  .intro_meme {
    position: relative;
    padding-block: calc(var(--space_block) * 8);
  }

  .intro_memes:first-child {
    padding-block-start: 0;
  }
  .intro_memes:last-child {
    padding-block-end: 0;
  }

  .content {
    text-align: left;
    position: relative;
    z-index: 1;
    margin: 0 auto;
    max-width: 60ch;
  }

  .background_svg {
    pointer-events: none;
    z-index: 0;
  }

  .background_svg :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
  .tagline {
    text-align: center;
    line-height: 1.1;
  }

  [data-theme="superstition"] .brand {
    color: var(--brand_dark);
  }
</style>
