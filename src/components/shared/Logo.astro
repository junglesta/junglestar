---
// @components/shared/LogoBrandFull.astro
import LogoSVG from "@assets/svgs/logo_stroke.svg";
---

<style>
  .logo_link {
    /*transform: rotate(0deg);*/
    display: grid;
    place-content: center;
    text-decoration: none;
    color: var(--brand_light);
  }

  .logo_link::after,
  .logo_link::before {
    content: "";
    display: none;
  }

  .logo {
    padding-top: calc(var(--space_block) * 1.55);
    text-transform: uppercase;
    font-size: 150%;
    width: 100%;
    text-align: center;
  }

  .logosvg {
    color: var(--white);
  }
</style>

<a
  class="logo_link clean file_Logo"
  title="This link goes back to junglestar.org homepage"
  href="/"
>
  <LogoSVG
    class="logosvg"
    width={155}
    height={155}
    fill="currentColor"
  />
</a>
