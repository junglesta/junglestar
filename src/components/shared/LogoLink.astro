---
// @components/shared/LogoLinkBrandFull.astro
import Logo from "@assets/svgs/logo_stroke.svg";
---

<style>
  .logo_link {
    /*transform: rotate(0deg);*/
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--brand_light);
  }

  .logo_link::after,
  .logo_link::before {
    content: "";
    display: none;
  }

  .logo {
    padding-top: calc(var(--space_block) * 3);
    text-transform: uppercase;
    font-size: 150%;
    width: 100%;
    text-align: center;
    color: var(--white);
  }

  .logo svg {
    width: 300px;
  }
</style>

<a
  class="logo_link clean file_Logo"
  title="This link goes back to junglestar.org homepage"
  href="/"
>
  <div class="logo">
    <Logo
      width={300}
      height={300}
      fill="currentColor"
    />
  </div>
</a>
