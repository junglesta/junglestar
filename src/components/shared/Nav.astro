---
// src/components/shared/Nav.astro
---

<style>
  nav {
    width: 100%;
    display: grid;
    place-content: center;
    gap: calc(var(--space_inline) / 5);
    margin-block: 0;
  }

  .button {
    text-transform: uppercase;
    width: 100%;
    border-color: currentColor;
    background-color: transparent;
  }

  @media (min-width: 510px) {
    .button {
      background-color: transparent;
    }
  }
  @media (min-width: 1100px) {
    .button {
      background-color: transparent;
    }
  }

  .bg_black .button {
    color: var(--white);
  }
</style>

<nav class="flexcolo" role="menu">
  <a
    class="button page_title"
    role="menuitem"
    title="Design and development"
    href="/design"
  >
    Communication Design
  </a>

  <a
    class="button page_title"
    role="menuitem"
    title="Content production and management"
    href="/content"
  >
    Content production
  </a>

  <a
    class="button page_title"
    role="menuitem"
    title="Let's put your biz on the map"
    href="/discoverability"
  >
    Your biz on the map
  </a>

  <a
    class="button page_title"
    role="menuitem"
    title="Packages offer"
    href="/offer"
  >
    Website Pricing
  </a>

  <a class="button page_title" role="menuitem" title="About Us" href="/about"
    >About
  </a>
</nav>
