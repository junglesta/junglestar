---
// src/components/shared/NavScroll.astro
import menu from "@data/menu.json";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<nav class="nav_scroll" role="menu">
	{
		menu.map((item) => (
			<a
				class="nav_scroll_item"
				role="menuitem"
				title={item.title}
				href={item.href}
				aria-current={currentPath === item.href ? "page" : undefined}
			>
				{item.label}
			</a>
		))
	}
</nav>

<style>
	.nav_scroll {
		display: flex;
		gap: calc(var(--space_inline) / 2.5);
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
		padding-inline: var(--space_inline);
		padding-block: calc(var(--space_block) / 3);
	}

	.nav_scroll::-webkit-scrollbar {
		display: none;
	}

	.nav_scroll_item {
		flex-shrink: 0;
		display: inline-block;
		height: var(--tap_size);
		line-height: var(--tap_size);
		padding-inline: calc(var(--space_inline) * 0.65);
		font-size: 0.9em;
		font-weight: var(--weight_med);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		white-space: nowrap;
		color: currentColor;
		border: 1.5px solid var(--blackT15);
		border-radius: var(--radius);
		text-decoration: none;
		user-select: none;
		opacity: 0.7;
	}

	.nav_scroll_item:hover,
	.nav_scroll_item:focus-visible {
		opacity: 1;
	}

	.nav_scroll_item::after {
		content: "";
		display: none;
	}

	.nav_scroll_item:active {
		transform: translateY(calc(var(--space_block) * 0.145));
	}

	.nav_scroll_item[aria-current="page"] {
		background-color: var(--blackT10);
		border-color: transparent;
		opacity: 1;
	}

</style>
