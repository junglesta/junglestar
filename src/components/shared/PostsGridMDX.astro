---
import { Image } from "astro:assets";
import type { MDXPost } from "@utils/getMDXPosts";
import { slugify } from "@utils/slugify";
import { getSvgContent } from "@utils/contentSvgs";
import AnimatedCard from "@components/UI/AnimateCardsCover.astro";

interface Props {
  posts: MDXPost<"designConcepts" | "productionConcepts">[];
  basePath: string;
}

const { posts = [], basePath } = Astro.props;
---

<div class="wrap margin_topx2 card_list">
  {
    posts.map((post) => {
      const svgContent = post.data.image ? getSvgContent(post.data.image.src) : null;
      const href = `/${basePath}/${slugify(post.data.title)}`;
      const transitionName = `post-img-${slugify(post.data.title)}`;

      return (
        <AnimatedCard end="33%" distance="33%" id={post.id} class:list={post}>
          <a href={href} class="card_link">
            {post.data.image && (
              <div class="post_image" transition:name={transitionName}>
                {svgContent ? (
                  <Fragment set:html={svgContent} />
                ) : (
                  <Image src={post.data.image.src} alt={post.data.image.alt} />
                )}
              </div>
            )}
            <div class="post_header">
              <h3 class="post_title">{post.data.title}</h3>
              {post.data.subtitle && (
                <p class="post_subtitle">{post.data.subtitle}&ensp;&rarr;</p>
              )}
              {!post.data.subtitle && <p class="post_subtitle">&rarr;</p>}
            </div>
          </a>
        </AnimatedCard>
      );
    })
  }
</div>
