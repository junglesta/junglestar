---
// src/layouts/Layout.astro
import LastPub from "@components/shared/LastPublished.astro";
import Footer from "@components/footer/Footer.astro";
import Head from "@components/heads/Head.astro";
import NavScroll from "@components/shared/NavScroll.astro";
import * as siteData from "@data/site.json";
import "@styles/global.css";

export interface Props {
  bodyClass?: string;
  mainClass?: string;
  title: string;
  description?: string;
  sitemap?: boolean;
  pageSubtitle?: string;
  hideNav?: boolean;
  tags?: string[];
  background?:
    | "--brand"
    | "--brand_light"
    | "--brand_lighter"
    | "--brand_dark"
    | "--brandT25"
    | "--brandT50"
    | "--brandT75"
    | "--jgreen"
    | "--jgreen_light"
    | "--jorange"
    | "--black"
    | "--white"
    | "--whiteOFF";
}

const {
  bodyClass,
  mainClass = "",
  title,
  description = siteData.description,
  sitemap = true,
  background = "--brand",
  hideNav = false,
  tags = [],
} = Astro.props;
---

<html lang="en">
  <Head title={title} description={description} sitemap={sitemap} tags={tags} />
  <LastPub />
  <body class={bodyClass} style={`background-color: var(${background})`}>
    {!hideNav && <NavScroll />}
    <header>
      <slot name="inside_header" />
    </header>

    <main class:list={["scrolling_body_wrap clickScrollTarget", mainClass]}>
      <slot />
    </main>

    <Footer />

    <!-- Inline script: only passes data to window -->
    <script is:inline define:vars={{ brand: siteData.brand, url: siteData.url }}
    >
      window.__SITE_DATA__ = { brand, url };
    </script>

    <!-- Processed script: handles imports -->
    <script>
      import { initPopipasta } from "@utils/popipasta";

      document.addEventListener("astro:page-load", () => {
        const { brand, url } = (window as any).__SITE_DATA__;
        initPopipasta(brand, url);
      });
    </script>

    <script>
      //Smooth scroll to target
      document.addEventListener("DOMContentLoaded", function () {
        const scrollButton = document.querySelector(".clickScrollTrigger");
        const scrollTarget = document.querySelector(".clickScrollTarget");

        if (scrollButton && scrollTarget) {
          scrollButton.addEventListener("click", function (e) {
            e.preventDefault();
            scrollTarget.scrollIntoView({
              behavior: "smooth",
            });
          });
        } else {
          console.log("Elements not found:", {
            button: !!scrollButton,
            target: !!scrollTarget,
          });
        }
      });
    </script>

    <script>
      import { openExternalLinksInNewWindow, markMailtoLinks } from "@utils/el";

      document.addEventListener("astro:page-load", () => {
        openExternalLinksInNewWindow();
        markMailtoLinks();

        document.querySelector(".back_button")?.addEventListener("click", () => {
          history.back();
        });
      });
    </script>
  </body>
</html>
