---
import Footer from "@components/footer/Footer.astro";
// src/layouts/Layout.astro
import LastPub from "@components/heads/LastPublished.astro";
import Head from "@components/heads/Head.astro";
import * as siteData from "@data/site.json";
import "@styles/global.css";
//import DevBrandColors from "@components/DevBrandColors.astro";

export interface Props {
  bodyClass?: string;
  mainClass?: string;
  title: string;
  description?: string;
  sitemap?: boolean;
  pageSubtitle?: string;
}

const {
  bodyClass,
  mainClass = "",
  title,
  description = "Sustainable Web Design to help fight Climate Change",
  sitemap = true,
} = Astro.props;
---

<style>
  /*@view-transition {
    navigation: auto;
  }*/
  main {
    background-color: var(--black);
    background-color: var(--white);
  }
  .scrolling_body_wrap {
    position: relative;
    z-index: 1;
  }
</style>

<html lang="en">
  <!-- ASCII art, dude! -->
  <!--
      _                   _           _
     | |_   _ _ __   __ _| | ___  ___| |_ __ _ _ __
  _  | | | | | '_ \ / _` | |/ _ \/ __| __/ _` | '__|
 | |_| | |_| | | | | (_| | |  __/\__ \ || (_| | |
  \___/ \__,_|_| |_|\__, |_|\___||___/\__\__,_|_|
                    |___/

 site     : https://junglestar.org
 email    : info@junglestar.org
-->

  <Head
    title={title}
    description={description}
    sitemap={sitemap}
  />

  <LastPub />

  <body class={bodyClass}>
    <div
      class="scrolling_body_wrap"
      id="top"
    >
      <slot name="landing_screen" />

      <main class={mainClass}>
        <slot />
      </main>
    </div>
    <Footer />

    <!-- Inline script: only passes data to window -->
    <script is:inline define:vars={{ brand: siteData.brand, url: siteData.url }}
    >
      window.__SITE_DATA__ = { brand, url };
    </script>

    <!-- Processed script: handles imports -->
    <script>
      import { initPopipasta } from "@utils/popipasta";

      document.addEventListener("astro:page-load", () => {
        const { brand, url } = (window as any).__SITE_DATA__;
        initPopipasta(brand, url);
      });
    </script>
  </body>
</html>

<script>
  import { openExternalLinksInNewWindow, markMailtoLinks } from "@utils/el";

  document.addEventListener("astro:page-load", () => {
    openExternalLinksInNewWindow();
    markMailtoLinks();
  });
</script>

