---
// src/layouts/Layout.astro

import LastPub from "@components/heads/LastPublished.astro";
import ViewportHeight from "@components/shared/ViewportHeight.astro";
import Footer from "@components/footer/Footer.astro";
import Head from "@components/heads/Head.astro";

// import WaveSection from "@components/UI/WaveSection.astro";
import * as siteData from "@data/site.json";
import "@styles/global.css";

export interface Props {
  bodyClass?: string;
  mainClass?: string;
  title: string;
  description?: string;
  sitemap?: boolean;
  pageSubtitle?: string;
}

const {
  bodyClass,
  mainClass = "",
  title,
  description = "Sustainable Web Design",
  sitemap = true,
} = Astro.props;
---

<style>
  /*@view-transition {
    navigation: auto;
  }*/
  main {
    background-color: var(--black);
    background-color: var(--white);
  }
  .scrolling_body_wrap {
  }
</style>

<html lang="en">
  <LastPub />
  <ViewportHeight />
  <Head
    title={title}
    description={description}
    sitemap={sitemap}
  />

  <body class={bodyClass}>
    <slot name="landing_screen" />

    <main class:list={["scrolling_body_wrap clickScrollTarget", mainClass]}>
      <slot />
    </main>

    <Footer />

    <!-- Inline script: only passes data to window -->
    <script is:inline define:vars={{ brand: siteData.brand, url: siteData.url }}
    >
      window.__SITE_DATA__ = { brand, url };
    </script>

    <!-- Processed script: handles imports -->
    <script>
      //Smooth scroll to target
      document.addEventListener("DOMContentLoaded", function () {
        const scrollButton = document.querySelector(".clickScrollTrigger");
        const scrollTarget = document.querySelector(".clickScrollTarget");

        if (scrollButton && scrollTarget) {
          scrollButton.addEventListener("click", function (e) {
            e.preventDefault();
            scrollTarget.scrollIntoView({
              behavior: "smooth",
            });
          });
        } else {
          console.log("Elements not found:", {
            button: !!scrollButton,
            target: !!scrollTarget,
          });
        }
      });
    </script>

    <script>
      import { initPopipasta } from "@utils/popipasta";

      document.addEventListener("astro:page-load", () => {
        const { brand, url } = (window as any).__SITE_DATA__;
        initPopipasta(brand, url);
      });
    </script>

    <script>
      import { openExternalLinksInNewWindow, markMailtoLinks } from "@utils/el";

      document.addEventListener("astro:page-load", () => {
        openExternalLinksInNewWindow();
        markMailtoLinks();
      });
    </script>
  </body>
</html>
