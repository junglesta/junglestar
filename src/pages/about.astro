---
// src/pages/about.astro
import Layout from "@layouts/Layout.astro";
import LandingScreen from "@components/UI/LandingScreen.astro";
import Icono from "@svgs/paperclip.svg";

// import type { ImageMetadata } from "astro";

// Page metadata
const overtitle_line1 = "Expertise you can trust.";

const title_start = "Junglestar Agency ";
const title_end = " About us";
const title = title_start + " | " + title_end;

const onScroll_line1 = "So you wanna know about us huh? ";
const onScroll_line2 = "Like who we really, really are, maybe?!";
const onScroll_line3 = "Or even get to know us personally.";
const onScroll_line4 = "Or meet in person... via videochat?!";
const onScroll_line5 =
  "Well, find some answers here. For everything else, write us.";
const description =
  "SHOWCASE: We helped these small enterprises with websites, apps, and marketing communication.";
---

<style>
  .vpad {
    padding-block: calc(var(--space_block) * 3);
  }
</style>

<Layout
  title={title}
  description={description}
  bodyClass="about bg_green_light"
  mainClass="about bg_white"
  background="--jgreen_light"
>
  <Fragment slot="inside_header">
    <LandingScreen
      title={title_start}
      overtitle_line1={overtitle_line1}
      onScroll_line1={onScroll_line1}
      onScroll_line2={onScroll_line2}
      onScroll_line3={onScroll_line3}
      onScroll_line4={onScroll_line4}
      onScroll_line5={onScroll_line5}
    >
      <Icono width={133} height={133} fill="currentColor" />
    </LandingScreen>
  </Fragment>

  <div class="wrap vpad">
    <details class="who">
      <summary class="center">
        <strong>Who are we?</strong><small> TLDR: A bunch of geeks.</small>
      </summary>
      <p class="wrap pretty">
        <br />
        Yes geeks. This definitely applies to the founder 'Old Boy'
        <a title="Junglestar founder" href="https://tldr.rokma.com"
          ><strong>Rokma</strong></a
        > and many collabs. Facts define labels.
      </p>
      <p class="wrap pretty">
        <strong> So we are a Group of Professionals Coders, </strong>
        with complementary skills, not necessarily particularly geeky.
      </p>
      <p class="wrap pretty">
        People work together and pay bills, over the net, in 2026. If they wanna
        think we are wearing pijMs and we're playing, let 'em think so! 'Who the
        cap fits, let them wear it'!
      </p>
      <p class="wrap pretty">
        Sometimes we also hire consultants, or freelance helpers in a one shot
        basis.
      </p>
      <p class="wrap pretty">It depends! On the project needs.</p>
      <br />
    </details>

    <details class="works">
      <summary class="center">
        <strong>Where can I see your work's history?</strong>
      </summary>
      <p class="wrap pretty">
        What if by looking at old works, we normalize old mistakes and immature
        styles, and overall get inspired by some expired interfaces?
      </p>

      <p class="wrap pretty">
        For this reason we decided to cut our complete list of PAST works and
        only show CURRENT ones. Here: <a href="/showcase">
          <strong>Showcase</strong>
        </a>
      </p>
    </details>

    <details class="works">
      <summary class="center">
        <strong>Where are your LIVE Projects?</strong>
      </summary>
      <p class="wrap pretty">
        Glad you open me, here: <br /><a href="/showcase">
          <strong>Showcase</strong>
        </a>
        .
      </p>
    </details>

    <details open class="">
      <summary class="center">
        <strong>Where we stand?</strong>
      </summary>
      <p class="wrap pretty">
        We stand for <strong>Actions & Productions.</strong> We think real-world speak
        louder than lingo & memes concoctions. No algo-speak ✌🏼 just juicy craftcakes.
      </p>
    </details>
  </div>
</Layout>
