---
// src/pages/about.astro
import Layout from "@layouts/Layout.astro";
import LandingScreen from "@components/UI/LandingScreen.astro";
import Icono from "@svgs/paperclip.svg";

// import type { ImageMetadata } from "astro";

// Page metadata
const overtitle_line1 = "Expertise you can trust.";

const title_start = "Junglestar Agency ";
const title_end = " About us";
const title = title_start + " | " + title_end;

const onScroll_line1 = "So you wanna know about us huh? ";
const onScroll_line2 = "Like who we really, really are, maybe?!";
const onScroll_line3 = "Or even get to know us personally.";
const onScroll_line4 = "Or meet in person...";
const onScroll_line5 = "via videochat.";
const description =
  "SHOWCASE: We helped these small enterprises with websites, apps, and marketing communication.";
---

<style>
  .vpad {
    padding-block: calc(var(--space_block) * 3);
  }
</style>

<Layout
  title={title}
  description={description}
  bodyClass="about bg_green_light"
  mainClass="about bg_white"
  background="--jgreen_light"
>
  <Fragment slot="inside_header">
    <LandingScreen
      title={title_start}
      overtitle_line1={overtitle_line1}
      onScroll_line1={onScroll_line1}
      onScroll_line2={onScroll_line2}
      onScroll_line3={onScroll_line3}
      onScroll_line4={onScroll_line4}
      onScroll_line5={onScroll_line5}
    >
      <Icono width={133} height={133} fill="currentColor" />
    </LandingScreen>
  </Fragment>

  <div class="wrap vpad">
    <details class="">
      <summary class="center">
        <strong>Who are we?</strong><small> TLDR: A bunch of geeks.</small>
      </summary>
      <p class="wrap pretty">
        <br />
        Yes geeks. This definitely applies to the founder 'Old Boy'
        <a title="Junglestar founder" href="https://tldr.rokma.com"
          ><strong>Rokma</strong></a
        > and many collabs. Facts define labels.<strong>
          So we are a Group of Professionals Coders,
        </strong>
        with complementary skills, not necessarily particularly geeky. People work
        together over the net in 2026, and pay bills. Let 'em think we're playing!
      </p>
      <p class="wrap pretty">
        Sometimes we also hire consultants, or freelance helpers one shot.
      </p>
      <p class="wrap pretty">It depends! On the project.</p>
      <br />
    </details>

    <details class="">
      <summary class="center">
        <strong>Where are your LIVE Projects?</strong>
      </summary>
      <p class="wrap pretty">
        Here: <a href="/showcase">Showcase</a>
        .
      </p>
    </details>

    <details open class="">
      <summary class="center">
        <strong>Where we stand?</strong>
      </summary>
      <p class="wrap pretty">
        We stand for <strong>Actions & Productions.</strong> We think real-world speak
        louder than lingo & memes concoctions. No algo-speak ✌🏼 just juicy craftcakes
        .
      </p>
    </details>
  </div>
</Layout>
