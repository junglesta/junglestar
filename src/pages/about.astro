---
// src/pages/projects.astro
import Layout from "@layouts/Layout.astro";
import LandingScreen from "@components/UI/LandingScreen.astro";
import Icono from "@svgs/what.svg";
import WorksCard from "@components/brand/WorksCard.astro";
import projectsData from "@data/works.json";

// import type { ImageMetadata } from "astro";

// Page metadata
const overtitle_line1 = "Expertise you can trust.";

const title_start = "Junglestar Agency ";
const title_end = " About us";
const title = title_start + " | " + title_end;

const onScroll_line1 = "Have a look... ";
const onScroll_line2 = "real-world productions of ours.";
const onScroll_line3 = "";
const onScroll_line4 = " Let inspiration come to you.";
const description =
  "SHOWCASE: We helped these small enterprises with websites, apps, and marketing communication.";

// Import all icons dynamically
//const icons = import.meta.glob<{ default: ImageMetadata }>("/src/assets/ico/**/*.{svg,png}", { eager: true });

const projects = projectsData.sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
---

<style>
  .vpad {
    padding-block: calc(var(--space_block) * 3);
  }
</style>

<Layout
  title={title}
  description={description}
  bodyClass="about bg_green"
  mainClass="about bg_white"
  background="--jgreen"
>
  <Fragment slot="inside_header">
    <LandingScreen
      title={title_start}
      overtitle_line1={overtitle_line1}
      onScroll_line1={onScroll_line1}
      onScroll_line2={onScroll_line2}
      onScroll_line4={onScroll_line4}
    >
      <Icono width={133} height={133} fill="currentColor" />
    </LandingScreen>
  </Fragment>

  <div class="wrap vpad">
    <details class="">
      <summary class="center">
        <strong>Who are we?</strong>
      </summary>
      <p class="wrap pretty">
        TLDR: A bunch of geeks. Starting from the founder 'Old Boy' <a
          title="Junglestar founder"
          href="https://tldr.rokma.com"><strong>Rokma</strong></a
        >. <br />We are <strong> a Group of Professionals Coders, </strong>
        with complementary skills, working together over the net.
      </p>
    </details>

    <details class="">
      <summary class="center">
        <strong>Where we stand?</strong>
      </summary>
      <p class="wrap pretty">
        We stand for <strong>Actions & Productions.</strong> We think real-world speak
        louder than lingo & memes concoctions. No algo-speak ✌🏼 just juicy craftcakes
        .
      </p>
    </details>

    <h1 class="center">Live Projects Showcase</h1>
    <br />
    <p class="center">Check them out! Please scroll down.</p>

    <div class="grid_projects">
      {
        projects.map(async (project) => {
          const iconPath = `/src/assets/ico/${project.icon.url}`;
          const images = import.meta.glob(
            "/src/assets/ico/**/*.{png,svg,jpg,jpeg,gif}",
          );
          const iconImage = await images[iconPath]?.();

          return (
            <WorksCard
              id={project.id}
              title={project.title}
              subtitle={project.subtitle}
              category={project.category}
              tags={project.tags}
              url={project.url}
              icon={project.icon}
              ico_url={(iconImage as any)?.default?.src || ""}
              permalink={project.permalink}
              description={project.description}
              date={project.date}
            />
          );
        })
      }
    </div>
  </div>
</Layout>
