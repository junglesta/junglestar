---
// src/pages/about.astro
import Layout from "@layouts/Layout.astro";
import LandingScreen from "@components/UI/LandingScreen.astro";
import Icono from "@svgs/junglestar_people.svg";
import Faq from "@components/UI/Faq.astro";

// Page metadata
const overtitle_line1 = "Over 30 years of proven communication expertise. A small communication agency.";

const title_start = "Junglestar Agency ";
const title_end = " About us";
const title = title_start + " | " + title_end;

const onScroll_line1 = "";
const onScroll_line2 = "";
const onScroll_line3 = "";
const onScroll_line4 = "TLDR: ";
const onScroll_line5 = "We help small biz dealing with the online jungle. We offer Guidance. Finding painpoints in workflows. Research and develop solutions. Make websites, apps, strategies and narratives. We grow relationships with clients.";
const description =
  "SHOWCASE: We helped these small enterprises with websites, apps, and marketing communication.";
---

<style>
  .vpad {
    padding-block: calc(var(--space_block) * 3);
  }

  .intro_block {
    background-color: #fff;
    border: 1px solid var(--brand);
    border-radius: var(--radius);
    padding: calc(var(--space_block) * 1.25) calc(var(--space_inline) * 1.5);
  }
  .intro_block > p {
    margin: 0;
    padding-bottom: calc(var(--space_block) * 0.75);
  }
  .intro_block > p:first-child {
    color: var(--brand);
  }
</style>

<Layout
  title={title}
  description={description}
  bodyClass="about"
  mainClass="about"
>
  <Fragment slot="page_intro">
    <LandingScreen
      title={title_start}
      overtitle_line1={overtitle_line1}
      onScroll_line1={onScroll_line1}
      onScroll_line2={onScroll_line2}
      onScroll_line3={onScroll_line3}
      onScroll_line4={onScroll_line4}
      onScroll_line5={onScroll_line5}
    >
      <Icono width={133} height={133} fill="currentColor" />
    </LandingScreen>
  </Fragment>

  <div class="section_band">
    <h2 class="center wrap">FREQUENTLY ASKED QUESTIONS</h2>
  </div>

  <div class="wrap vpad">
    <Faq />
  </div>
</Layout>
