---
// Example usage page for AutoContrast component
import AutoContrast from "../components/AutoContrast.astro";
import "../styles/layers/tokens.css";

// Using your design tokens directly as CSS variables
const demoColors = [
  { var: "var(--black)", name: "--black" },
  { var: "var(--black_fumes)", name: "--black_fumes" },
  { var: "var(--white)", name: "--white" },
  { var: "var(--brand)", name: "--brand" },
  { var: "var(--brand_invert)", name: "--brand_invert" },
  { var: "var(--brand_complementary)", name: "--brand_complementary" },
  { var: "var(--brand_light)", name: "--brand_light" },
  { var: "var(--brand_dark)", name: "--brand_dark" },
  { var: "var(--text_color)", name: "--text_color" },
  { var: "var(--grey_color)", name: "--grey_color" },
  { var: "var(--grey_color_light)", name: "--grey_color_light" },
  { var: "var(--grey_color_dark)", name: "--grey_color_dark" },
  { var: "var(--product_category_1)", name: "--product_category_1" },
  { var: "var(--product_category_2)", name: "--product_category_2" },
  { var: "var(--product_category_3)", name: "--product_category_3" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AutoContrast Component Demo</title>
    <style is:global>
      /* Fallback tokens in case external CSS doesn't load */
      :root {
        --black: oklch(0 0 0);
        --black_fumes: #161616;
        --blackT25: color-mix(in oklch, var(--black), transparent 75%);
        --blackT50: color-mix(in oklch, var(--black), transparent 50%);

        --white: oklch(0.95 0.01 255 / 100%);
        --whiteT25: oklch(0.95 0.01 255 / 25%);
        --whiteT50: oklch(0.95 0.01 255 / 50%);

        --brand: oklch(0.5286 0.1735 255);
        --brand_invert: oklch(0.7687 0.1641 58.66);
        --brand_complementary: oklch(0.6201 0.156454 53.4649);
        --brandT25: color-mix(in oklch, var(--brand), transparent 75%);
        --brandT50: color-mix(in oklch, var(--brand), transparent 50%);
        --brand_light: oklch(from var(--brand) calc(l + 0.03) c h);
        --brand_dark: oklch(from var(--brand) calc(l - 0.18) c h);

        --text_color: #111111;
        --grey_color: #212121;
        --grey_color_light: #868686;
        --grey_color_dark: #000000;

        --product_category_1: hsla(117, 100%, 81%, 0.75);
        --product_category_2: hsla(43, 100%, 81%, 0.75);
        --product_category_3: hsla(205, 100%, 81%, 0.75);

        --font_family: -apple-system, BlinkMacSystemFont, Segoe UI, "Inter", Helvetica, Arial, sans-serif;
        --line_height: 1.5;
        --weight: 300;
        --weight_med: 400;
        --weight_bold: 600;
        --weight_heavy: 900;
        --radius: clamp(3px, 0.5rem, 1.5rem);

        --background_blackT05: rgba(0, 0, 0, 0.05);
        --header_shadow: 0 2px 4px rgba(0, 0, 0, 0.16);
        --card_shadow: 0px 0px 2px 0px rgba(0, 0, 0, 0.12), 0px 2px 2px 0px rgba(0, 0, 0, 0.24);
        --card_shadow_hover: 0px 0px 8px 0px rgba(0, 0, 0, 0.12), 0px 8px 8px 0px rgba(0, 0, 0, 0.24);
        --main_shadow:
          0px 2px 4px -1px rgba(0, 0, 0, 0.2), 0px 4px 5px 0px rgba(0, 0, 0, 0.14), 0px 1px 10px 0px rgba(0, 0, 0, 0.12);
        --transition_shadow: box-shadow 0.2s ease;
      }
    </style>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: var(--font_family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
        padding: 0;
        background: linear-gradient(135deg, var(--brand) 0%, var(--brand_complementary) 100%);
        min-height: 100vh;
      }

      .hero {
        background: var(--white);
        padding: 4rem 2rem;
        text-align: center;
        box-shadow: var(--header_shadow);
      }

      .hero h1 {
        font-size: 3rem;
        font-weight: var(--weight_heavy, 800);
        background: linear-gradient(135deg, var(--brand) 0%, var(--brand_invert) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 1rem;
      }

      .hero p {
        font-size: 1.25rem;
        color: var(--grey_color);
        max-width: 600px;
        margin: 0 auto;
      }

      .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 3rem 2rem;
      }

      .section-title {
        font-size: 2rem;
        font-weight: var(--weight_bold, 700);
        color: var(--white);
        margin: 3rem 0 1.5rem;
        text-shadow: 0 2px 4px var(--blackT50);
      }

      .section-subtitle {
        color: var(--whiteT50);
        font-size: 1.1rem;
        margin-bottom: 2rem;
        font-weight: var(--weight, 300);
      }

      /* Featured Demo Card */
      .featured-demo {
        background: var(--white);
        border-radius: var(--radius);
        padding: 3rem;
        margin-bottom: 3rem;
        box-shadow: var(--main_shadow);
      }

      .featured-demo h2 {
        color: var(--text_color);
        font-size: 1.75rem;
        margin-bottom: 1rem;
      }

      .featured-demo p {
        color: var(--grey_color);
        margin-bottom: 2rem;
        font-size: 1rem;
        line-height: var(--line_height);
      }

      .card {
        padding: 2.5rem;
        border-radius: var(--radius);
        min-height: 180px;
        box-shadow: var(--card_shadow);
        transition:
          var(--transition_shadow),
          transform 0.3s ease;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .card:hover {
        transform: translateY(-4px);
        box-shadow: var(--card_shadow_hover);
      }

      .card h3 {
        font-size: 1.5rem;
        margin-bottom: 0.75rem;
        font-weight: 600;
      }

      .card p {
        opacity: 0.9;
        line-height: 1.6;
      }

      .demo-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
      }

      .color-picker-wrapper {
        margin-top: 2rem;
        padding: 2rem;
        background: var(--whiteT25);
        border-radius: var(--radius);
        backdrop-filter: blur(10px);
      }

      .color-picker-wrapper label {
        display: block;
        margin-bottom: 1rem;
        font-weight: var(--weight_bold, 600);
        color: var(--white);
        font-size: 1.1rem;
      }

      .color-picker-container {
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
      }

      .color-picker {
        flex: 1;
        min-width: 200px;
        height: 80px;
        border: 3px solid var(--white);
        border-radius: var(--radius);
        cursor: pointer;
        box-shadow: var(--card_shadow);
        transition: transform 0.2s ease;
      }

      .color-picker:hover {
        transform: scale(1.05);
      }

      .color-value {
        background: var(--white);
        padding: 1rem 1.5rem;
        border-radius: var(--radius);
        font-family: "Courier New", monospace;
        font-weight: var(--weight_bold, 600);
        color: var(--text_color);
        font-size: 1.25rem;
        box-shadow: var(--card_shadow);
      }

      .tag-showcase {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
      }

      .mini-card {
        padding: 1.5rem;
        border-radius: var(--radius);
        box-shadow: var(--card_shadow);
        transition: transform 0.3s ease;
      }

      .mini-card:hover {
        transform: translateY(-2px);
      }

      .mini-card h4 {
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
      }

      .mini-card p {
        font-size: 0.95rem;
        opacity: 0.9;
      }

      .palette-card {
        text-align: center;
        padding: 2rem 1rem;
        border-radius: var(--radius);
        box-shadow: var(--card_shadow);
        transition: transform 0.3s ease;
      }

      .palette-card:hover {
        transform: scale(1.05);
      }

      .palette-card strong {
        display: block;
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
        font-family: "Courier New", monospace;
        font-weight: var(--weight_bold, 600);
      }

      .palette-card .var-name {
        display: block;
        font-size: 0.85rem;
        opacity: 0.7;
        font-family: "Courier New", monospace;
        margin-bottom: 0.5rem;
        font-weight: normal;
      }

      .palette-card p {
        font-size: 0.9rem;
        opacity: 0.85;
      }

      .info-badge {
        display: inline-block;
        background: var(--brandT25);
        color: var(--brand);
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: var(--weight_bold, 600);
        margin-top: 1rem;
      }

      code {
        font-family: "Courier New", monospace;
        font-size: 0.9em;
      }

      .card code,
      .mini-card code {
        background: rgba(255, 255, 255, 0.2);
        padding: 0.2em 0.5em;
        border-radius: 4px;
      }

      @media (max-width: 768px) {
        .hero h1 {
          font-size: 2rem;
        }

        .hero {
          padding: 2rem 1rem;
        }

        .container {
          padding: 2rem 1rem;
        }

        .featured-demo {
          padding: 2rem;
        }

        .demo-grid {
          grid-template-columns: 1fr;
        }

        .tag-showcase {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <div class="hero">
      <h1>✨ AutoContrast Component</h1>
      <p>Automatically calculates the perfect text color for any background using WCAG luminance formulas</p>
    </div>

    <div class="container">
      <!-- Interactive Demo Section -->
      <div class="featured-demo">
        <h2>🎨 Interactive Color Picker</h2>
        <p>
          Select any background color and watch the magic happen! The text color automatically switches between black
          and white to maintain optimal contrast and readability.
        </p>

        <AutoContrast backgroundColor="var(--brand)" class="card" id="interactive-card">
          <h3>Dynamic Color Adjustment</h3>
          <p
            >This text automatically adapts for perfect contrast! The component uses the WCAG 2.1 relative luminance
            formula to determine whether black or white text provides better readability. Currently using <code
              style="background: var(--whiteT25); padding: 0.2em 0.5em; border-radius: 4px;">var(--brand)</code
            > with OKLCH color space.</p
          >
          <span class="info-badge">✓ WCAG Compliant</span>
        </AutoContrast>

        <div class="color-picker-wrapper">
          <label for="colorPicker">🎨 Choose Your Color:</label>
          <div class="color-picker-container">
            <input type="color" id="colorPicker" class="color-picker" />
            <div class="color-value" id="colorValue">Loading...</div>
          </div>
        </div>
      </div>

      <!-- Different HTML Tags Section -->
      <h2 class="section-title">📦 Flexible HTML Elements</h2>
      <p class="section-subtitle">Works with any HTML tag using the 'tag' prop</p>

      <div class="tag-showcase">
        <AutoContrast backgroundColor="var(--brand_invert)" tag="section" class="mini-card">
          <h4>&lt;section&gt; Tag</h4>
          <p>Using <code style="opacity: 0.7;">var(--brand_invert)</code></p>
        </AutoContrast>

        <AutoContrast backgroundColor="var(--product_category_1)" tag="article" class="mini-card">
          <h4>&lt;article&gt; Tag</h4>
          <p>Using <code style="opacity: 0.7;">var(--product_category_1)</code></p>
        </AutoContrast>

        <AutoContrast backgroundColor="var(--product_category_2)" tag="aside" class="mini-card">
          <h4>&lt;aside&gt; Tag</h4>
          <p>Using <code style="opacity: 0.7;">var(--product_category_2)</code></p>
        </AutoContrast>

        <AutoContrast backgroundColor="var(--brand)" tag="header" class="mini-card">
          <h4>&lt;header&gt; Tag</h4>
          <p>Using <code style="opacity: 0.7;">var(--brand)</code></p>
        </AutoContrast>
      </div>

      <!-- Color Palette Showcase -->
      <h2 class="section-title">🎨 Color Palette Showcase</h2>
      <p class="section-subtitle">Your design tokens with real OKLCH colors and automatic contrast</p>

      <div class="demo-grid">
        {
          demoColors.map((color) => (
            <AutoContrast backgroundColor={color.var} class="palette-card">
              <strong>{color.name}</strong>
              <span class="var-name">{color.var}</span>
              <p>Auto-contrasted text for perfect readability</p>
            </AutoContrast>
          ))
        }
      </div>

      <!-- Usage Example -->
      <div class="featured-demo">
        <h2>💻 Quick Start</h2>
        <p style="color: var(--grey_color); margin-bottom: 1.5rem;"> Using the AutoContrast component is simple: </p>
        <pre
          style="background: var(--background_blackT05); padding: 1.5rem; border-radius: var(--radius); overflow-x: auto; color: var(--text_color); font-size: 0.9rem;"
          ><code>&lt;AutoContrast backgroundColor="#0069cc"&gt;
  &lt;h2&gt;Your Content&lt;/h2&gt;
  &lt;p&gt;Text automatically contrasts!&lt;/p&gt;
&lt;/AutoContrast&gt;</code></pre
        >
      </div>
    </div>

    <script>
      // Interactive color picker following Astro best practices
      // Astro scripts are bundled and run as type="module" automatically

      const colorPicker = document.getElementById("colorPicker") as HTMLInputElement;
      const colorValue = document.getElementById("colorValue");
      const interactiveCard = document.getElementById("interactive-card") as any;

      // Helper function to convert RGB to hex
      function rgbToHex(rgb: string): string {
        const match = rgb.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
        if (!match) return "#000000";

        const r = parseInt(match[1]);
        const g = parseInt(match[2]);
        const b = parseInt(match[3]);

        return (
          "#" +
          [r, g, b]
            .map((x) => {
              const hex = x.toString(16);
              return hex.length === 1 ? "0" + hex : hex;
            })
            .join("")
        );
      }

      if (colorPicker && interactiveCard && colorValue) {
        // Get the computed background color and set it to the picker
        const computedBg = window.getComputedStyle(interactiveCard).backgroundColor;
        const hexColor = rgbToHex(computedBg);
        colorPicker.value = hexColor;
        colorValue.textContent = hexColor;

        // Listen for color changes
        colorPicker.addEventListener("input", (e) => {
          const color = (e.target as HTMLInputElement).value;

          // Update the displayed hex value
          colorValue.textContent = color;

          // Update the card's background color
          if (typeof interactiveCard.setBackgroundColor === "function") {
            interactiveCard.setBackgroundColor(color);
          }
        });
      } else {
        console.error("Color picker elements not found:", {
          colorPicker: !!colorPicker,
          interactiveCard: !!interactiveCard,
          colorValue: !!colorValue,
        });
      }
    </script>
  </body>
</html>
