---
// src/pages/books/index.astro
import Layout from "@layouts/Layout.astro";
import BookBatClient from "@bookbat/baobab/BookBatClient.astro";
import { parseLibraryPayload } from "@bookbat/library-core";
// library.generated.json is produced by scripts/cache-covers.mjs (pnpm covers /
// prebuild): same data as library.json but with coverUrl pointing at the local
// build-time-cached covers under /book-covers/.
import library from "@data/library.generated.json";

// Page metadata
const pageTitle = "Junglestar | Books";
const description = "Books we track and recommend.";

const books = parseLibraryPayload(library);
---

<Layout title={pageTitle} description={description} bodyClass="books">
  <BookBatClient
    books={books}
    config={{ showHeader: false, sort: "rating", sortDirection: "desc" }}
  />
</Layout>

<style is:global>
  /*
   * Most of the books styling now lives inside the Baobab component itself
   * (@bookbat/baobab) — accent, borders, radius, no green frame, collapsible
   * search, sliding view toggle, synopsis clamp, dark <select>, etc. This page
   * only sets the page-level chrome + counters the site's global CSS.
   */

  /* Dark region palette for the page chrome (head / main / footer). */
  .books {
    --region_head: var(--black);
    --fg_head: var(--white);
    --region_main: var(--black);
    --fg_main: var(--white);
    --region_foot: var(--black);
    --fg_foot: var(--white);
  }

  /* Stop junglestar's GLOBAL details/summary rules (the injected "+" marker,
     centered summary, top borders, vertical offset) from bleeding into the
     embedded component. This counters the site's layout layer, not Baobab. */
  .books .bfc details,
  .books .bfc details[open] {
    text-align: left;
    padding-bottom: 0;
  }
  .books .bfc .bfc_summary {
    top: 0;
    min-height: 0;
    height: auto;
    padding-top: 0;
    border-top: 0;
    justify-content: flex-start;
    align-items: stretch;
  }
  .books .bfc .bfc_summary::after,
  .books .bfc details[open] .bfc_summary::after {
    content: none;
  }
  .books .bfc details[open] .bfc_summary {
    margin-bottom: 0;
    border-top: 0;
  }

  /* Search box: always-expanded + wider, at EVERY width. Baobab collapses the
     search to a magnifier-only icon that opens on focus — easy to miss. With
     275 titles we pin the expanded state so the input is visible by default.
     The collapse rules are unmediated in the component, so this override must
     be too (an earlier min-width:768px-only version left mobile collapsed).
     Give search its own full-width row above the sort/filter controls. */
  .books .bfc .bfc_control--search {
    flex: 1 1 100%;
  }
  .books .bfc .bfc_control--search input {
    width: 100%;
    max-width: 30rem;
    padding-inline: 40px calc(var(--padding) - 4px);
    color: var(--text);
    cursor: text;
    background-position: 12px center;
  }
  .books .bfc .bfc_control--search input::placeholder {
    color: var(--text-muted);
  }

</style>
