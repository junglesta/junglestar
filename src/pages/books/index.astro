---
// src/pages/books/index.astro
import Layout from "@layouts/Layout.astro";
import BookBatClient from "@bookbat/baobab/BookBatClient.astro";
import { parseLibraryPayload } from "@bookbat/library-core";
import library from "@data/library.json";

// Page metadata
const pageTitle = "Junglestar | Books";
const description = "Books we track and recommend.";

const books = parseLibraryPayload(library);
---

<Layout title={pageTitle} description={description} bodyClass="books">
  <BookBatClient books={books} config={{ showHeader: false }} />
</Layout>

<style is:global>
  /* Dark palette — dark regions, light text, across head / main / footer. */
  .books {
    --region_head: var(--black);
    --fg_head: var(--white);
    --region_main: var(--black);
    --fg_main: var(--white);
    --region_foot: var(--black);
    --fg_foot: var(--white);
  }

  /* BAOBAB ships its own <details> styling. Stop junglestar's global
     details/summary rules (the injected "+" marker, centered summary,
     top borders, vertical offset) from bleeding into the embedded
     component so it keeps its OG look and the titles read left-aligned. */
  .books .bfc details,
  .books .bfc details[open] {
    text-align: left;
    padding-bottom: 0;
    border-radius: 0;
  }
  .books .bfc .bfc_summary {
    top: 0;
    min-height: 0;
    height: auto;
    padding-top: 0;
    border-top: 0;
    justify-content: flex-start;
    align-items: stretch;
  }
  .books .bfc .bfc_summary::after,
  .books .bfc details[open] .bfc_summary::after {
    content: none;
  }
  .books .bfc details[open] .bfc_summary {
    margin-bottom: 0;
    border-top: 0;
  }

  /* Outer list column flush within the panel (card text keeps its padding —
     .bfc_main is reused for both the list column and each card's text block). */
  .books .bfc_body > .bfc_main {
    padding-inline: 0;
  }

  /* Sticky search on mobile. The component already pins the whole sidebar on
     desktop (>=1100px). On phones the controls stack above the list, so flatten
     the sidebar + controls wrappers (display:contents) to make .bfc_body the
     search's containing block, then pin only the search row to the top. */
  @media (max-width: 767px) {
    .books .bfc_sidebar,
    .books .bfc_controls {
      display: contents;
    }
    .books .bfc_control--search {
      position: sticky;
      top: 0;
      z-index: 10;
      background: var(--bg-body);
      padding-block: 10px;
    }
  }
</style>
