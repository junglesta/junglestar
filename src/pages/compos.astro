---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

const modules = import.meta.glob<{ default: AstroComponentFactory }>(
  "../components/*.astro",
  { eager: true }
);

console.log("Found modules:", Object.keys(modules));
const components = Object.entries(modules || {});
---

{
  components.map(([path, component]) => (
    <div>
      <p>Component: {path}</p>
      <!-- Temporarily comment out rendering to isolate -->
      <!-- <component.default size={24} /> -->
    </div>
  ))
}
