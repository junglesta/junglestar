---
import Layout from "@layouts/Layout.astro";
import LandingScreen from "@components/UI/HeaderAni2Black.astro";
import SocialMediaManagement from "@components/brand/SocialMediaManagement.astro";
import TableOfContents from "@components/UI/TableOfContents.astro";
import PostsGridMDX from "@components/shared/PostsGridMDX.astro";
import CTAMailBanner from "@components/UI/CTAMailBanner.astro";
import { getMDXPosts } from "@utils/getMDXPosts";

const posts = await getMDXPosts("productionConcepts");

const pageTitle = "Junglestar | Content Production";
const pageSubtitle = "Brand Narrative";
const pageRevealOnScroll1 = "Brand Narrative? What's that?";
const pageRevealOnScroll2 = "Why do I need that?";
const pageRevealOnScroll3 = "Keep on scrolling... for answers.";
const pageDescription =
  "What people remember you for. Brand narrative is that discourse. We help small enterprises with websites, apps, and marketing communication.";
---

<style>
  h1 {
    color: var(--black);
  }
</style>

<Layout
  title={pageTitle}
  description={pageDescription}
  pageSubtitle={pageSubtitle}
>
  <LandingScreen>
    {pageSubtitle}
    <p class="brand small_text">
      {pageRevealOnScroll1}<br /><br />
      {pageRevealOnScroll2}<br /><br />
      {pageRevealOnScroll3}
    </p>
  </LandingScreen>

  <SocialMediaManagement />

  <div class="wrap">
    <h2 class="center"
      >What people remember you for. Brand narrative is that. The whole thing.</h2
    >
    <TableOfContents posts={posts} />
    <PostsGridMDX posts={posts} />
  </div>

  <CTAMailBanner
    subject="Send more infos about Junglestar's Content Production"
  />
</Layout>
