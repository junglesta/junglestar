---
import Layout from "@layouts/Layout.astro";
import LandingScreen from "@components/HeaderAni2Black.astro";
import SocialMediaManagement from "@components/SocialMediaManagement.astro";
import TableOfContents from "@components/TableOfContents.astro";
import PostsGrid from "@components/PostsGrid.astro";
import CTABanner from "@components/CTABanner.astro";
import { getRenderedPosts } from "@utils/getPosts";

const renderedPosts = await getRenderedPosts("productionConcepts");

const pageTitle = "Junglestar | Content Production";
const pageSubtitle = "Brand Narrative";
const pageRevealOnScroll1 = "Brand Narrative? What's that?";
const pageRevealOnScroll2 = "Why do I need that?";
const pageRevealOnScroll3 = "Keep on scrolling... for answers.";
const pageDescription =
  "Sustainable Web Design to help fight to help the planet. Change. We help small enterprises with websites, apps, and marketing communication.";
---

<style>
  h1 {
    color: var(--black);
  }
</style>

<Layout title={pageTitle} description={pageDescription} pageSubtitle={pageSubtitle}>
  <LandingScreen>
    {pageSubtitle}
    <p class="brand small_text">
      {pageRevealOnScroll1}<br /><br />
      {pageRevealOnScroll2}<br /><br />
      {pageRevealOnScroll3}
    </p>
  </LandingScreen>

  <SocialMediaManagement />

  <TableOfContents posts={renderedPosts} />

  <PostsGrid posts={renderedPosts} />

  <CTABanner subject="Send me more infos about Junglestar's Content Production" />
</Layout>
