---
//pages/content.astro
import Layout from "@layouts/Layout.astro";
import Ani from "@components/UI/HeaderAni2Black.astro";
import Wave from "@components/UI/Wave.astro";
import LandingScreen from "@components/UI/LandingScreen.astro";

import SocialMediaManagement from "@components/brand/SocialMediaManagement.astro";

import TableOfContents from "@components/UI/TableOfContents.astro";
import PostsGridMDX from "@components/shared/PostsGridMDX.astro";
import { getMDXPosts } from "@utils/getMDXPosts";
const posts = await getMDXPosts("productionConcepts");

// Page metadata
const overtitle_line1 = "Marketing";
const overtitle_line2 = "Communication.";
const overtitle_line3 = "Simplified.";

const title_start = "Junglestar ";
const title_end = " Content Production";
const title = title_start + " | " + title_end;
const pageTitle = "Brand Narrative";

const onScroll_line1 = "Brand Narrative?";
const onScroll_line2 = "What's that?";
const onScroll_line3 = "Why do I need that?";
const onScroll_line4 = " ";
const onScroll_line5 = "Keep on scrolling... ";
const onScroll_line6 = "We got answers!";

//
const pageDescription =
  "What people remember you for. Brand narrative is that discourse. We help small enterprises with websites, apps, and marketing communication.";
---

<style>
  h1 {
    color: var(--black);
  }
</style>

<Layout
  title={title}
  description={pageDescription}
  bodyClass="content"
>
  <Ani>
    <LandingScreen
      overtitle_line1={overtitle_line1}
      overtitle_line2={overtitle_line2}
      overtitle_line3={overtitle_line3}
      title={pageTitle}
      onScroll_line1={onScroll_line1}
      onScroll_line2={onScroll_line2}
      onScroll_line3={onScroll_line3}
      onScroll_line4={onScroll_line4}
      onScroll_line5={onScroll_line5}
      onScroll_line6={onScroll_line6}
    />
  </Ani>

  <Wave
    color="var(--white)"
    position="top"
  />

  <div class="wrap">
    <h2 class="center"
      >What people remember you for. Brand narrative is that. The whole thing.</h2
    >
    <TableOfContents posts={posts} />
    <PostsGridMDX posts={posts} />
  </div>

  <div class="space_block"></div>
  <Wave
    color="var(--black)"
    position="top"
  />

  <SocialMediaManagement />

  <Wave
    color="var(--white)"
    position="bottom"
  />

  <div class="space8"></div>
</Layout>
