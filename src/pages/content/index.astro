---
// src/pages/content.astro
import Layout from "@layouts/Layout.astro";
import Icono from "@svgs/what.svg";
import LandingScreen from "@components/UI/LandingScreen.astro";

import SocialMediaManagement from "@components/brand/SocialMediaManagement.astro";

import PostsGridMDX from "@components/shared/PostsGridMDX.astro";
import { getMDXPosts } from "@utils/getMDXPosts";
const posts = await getMDXPosts("productionConcepts");

// Page metadata
const overtitle_line1 = "";
const overtitle_line2 = "";
const overtitle_line3 = "Marketing Communication Simplified.";

const title_start = "Junglestar ";
const title_end = " Content Production";
const title = title_start + " | " + title_end;
const h1= 'YOUR BRAND NARRATIVE?';

const onScroll_line1 = "";
const onScroll_line2 = "";
const onScroll_line3 = "Competing for attention. OK, how? Your paid ads are converting very little? Drowning in sticky-notes and to-do-lists?";
const onScroll_line4 = "";
const onScroll_line5 = "";
const onScroll_line6 = "";
//
const description =
  "What people remember you for. Brand narrative is that discourse. We help small enterprises with websites, apps, and marketing communication.";
---

<style>
  /* The shared .section_band background is var(--brand) (= the card borders),
     which on /content is the light orange — so keep the heading text dark
     (the shared white default would be unreadable on it). */
  .section_band h1 {
    color: var(--fg_main);
  }

  /* Second "mean" banner: a deeper orange tier for emphasis. */
  body.content :global(.mean_title.mean_title--second) {
    --brand: var(--jorange_dark);
    background-color: var(--jorange_dark);
  }
</style>

<Layout
  title={title}
  description={description}
  bodyClass="content"
  master="--jorange"
>
  <Fragment slot="page_intro">
    <LandingScreen

    title={h1}
      overtitle_line1={overtitle_line1}
      overtitle_line2={overtitle_line2}
      overtitle_line3={overtitle_line3}
      onScroll_line1={onScroll_line1}
      onScroll_line2={onScroll_line2}
      onScroll_line3={onScroll_line3}
      onScroll_line4={onScroll_line4}
      onScroll_line5={onScroll_line5}
      onScroll_line6={onScroll_line6}
    >
      <Icono width={133} height={133} fill="currentColor" />
    </LandingScreen>
  </Fragment>

  <div class="section_band">
    <h1 class="center wrap">
      What people remember you for. Brand narrative is that. The whole thing.
    </h1>
  </div>

  <div class="wrap">
    <PostsGridMDX posts={posts} basePath="content" />
  </div>

  <div class="space_block"></div>

  <SocialMediaManagement />
</Layout>
