---
import Layout from "@layouts/Layout.astro";
import LandingScreen from "@components/UI/HeaderAni2OffWhite.astro";
import TableOfContents from "@components/UI/TableOfContents.astro";
import Wave from "@components/UI/Wave.astro";

import PostsGridMDX from "@components/shared/PostsGridMDX.astro";
import CTAMailBanner from "@components/UI/CTAMailBanner.astro";
import { getMDXPosts } from "@utils/getMDXPosts";

const posts = await getMDXPosts("designConcepts");

const pageTitle = "Design, Sustainabilty!? Because Why?";
const pageSubtitle = "Design, Sustainabilty!? Because Why?";
const pageRevealOnScroll1 = "Ever feel prisoner of your own processes?";
const pageRevealOnScroll2 = "Those ones necessary to run your biz?";
const pageRevealOnScroll3 =
  "Find out what sustainable actually means for us small entrepreneurs.";
const description =
  "Sustainable Web Design to help the planet. Change. We help small enterprises with websites, apps, and marketing communication.";
---

<style>
  h1 {
    color: var(--black);
  }
</style>

<Layout
  title={pageTitle}
  description={description}
  pageSubtitle={pageSubtitle}
  bodyClass="design"
  mainClass="dd"
>
  <LandingScreen>
    {pageSubtitle}
    <p class="brand small_text">
      {pageRevealOnScroll1}<br /><br />
      {pageRevealOnScroll2}<br /><br />
      {pageRevealOnScroll3}
    </p>
  </LandingScreen>

  <Wave
    color="var(--white)"
    position="top"
  />

  <div class="wrap">
    <h2 class="center">Thinking communication design does deliver!</h2>
    <TableOfContents posts={posts} />
    <PostsGridMDX posts={posts} />
  </div>
  <CTAMailBanner subject="Send more infos about Junglestar's Design" />

  <Wave
    color="var(--white)"
    position="bottom"
  />
  <div class="space8"></div>
</Layout>
