---
//  src/pages/desing.astro
import Layout from "@layouts/Layout.astro";
import Icono from "@svgs/island.svg";
import LandingScreen from "@components/UI/LandingScreen.astro";
import CTAMailBanner from "@components/UI/CTAMailBanner.astro";

import PostsGridMDX from "@components/shared/PostsGridMDX.astro";

import { getMDXPosts } from "@utils/getMDXPosts";
const posts = await getMDXPosts("designConcepts");

// Page metadata
const title_start = "Sustainable by design";
const title_end = " ";
const title = title_start + " | " + title_end;

const overtitle_line1 = "";

const onScroll_line1 = "Ever feel prisoner of processes you created?";
const onScroll_line2 = "Those ones necessary to run your biz?";
const onScroll_line4 =
  "Find out what sustainable actually means, for all us small entrepreneurs.";
const onScroll_line5 = "";
const description =
  "Sustainable Web Design to help the planet. Change! We help small enterprises with websites, apps, and marketing communication.";
---

<Layout
  title={title}
  description={description}
  bodyClass="design"
>
  <Fragment slot="inside_header">
    <LandingScreen
      title={title_start}
      overtitle_line1={overtitle_line1}
      onScroll_line1={onScroll_line1}
      onScroll_line2={onScroll_line2}
      onScroll_line4={onScroll_line4}
      onScroll_line5={onScroll_line5}
    >
      <Icono fill="currentColor" />
    </LandingScreen>
  </Fragment>

  <div class="section_band">
    <h1 class="center wrap">What is communication design?</h1>
  </div>

  <div class="wrap">
    <PostsGridMDX posts={posts} basePath="design" />
  </div>
  <div class="banner_wrap">
    <CTAMailBanner />
  </div>
</Layout>

<style is:global>
  /* Page tone — luma only, same brand hue/chroma. One notch darker than the
     default blue; footer untouched (--region_foot uses absolute L + unchanged
     chroma/hue). See showcase/offer for the rest of the per-page ramp. */
  body.design {
    --brand: oklch(0.52 0.24 255);
    --region_head: oklch(from var(--brand) 0.41 c h);
    --region_main: oklch(from var(--brand) 0.96 calc(c * 0.18) h);
  }
</style>
