---
// src/pages/discoverability.astro
import Layout from "@layouts/Layout.astro";
import LandingScreen from "@components/UI/LandingScreen.astro";
import Icono from "@svgs/gmap_pin.svg";
import Gmap from "@components/brand/Gmap.astro";

// Page metadata
const overtitle_line1 = "Ever get msg like: Pls send me your location?";
const overtitle_line2 = "";
const overtitle_line3 = "";

const title_start = "Location's paramount? ";
const title_end = " Content Production";
const title = title_start + " | " + title_end;
const pageTitle = "YOUR LOCATION?";

const onScroll_line1 = "";
const onScroll_line2 = "";
const onScroll_line3 = "How you deal with it? Like:";
const onScroll_line4 = "''LEFT, THEN RIGHT...'' Or maybe: ''ASK FOR ... EVERYONE KNOWS''";
const onScroll_line5 = "What used to work doesn't anymore. Now what?";
const onScroll_line6 = "";
const description =
  "Flexible one-stop web agency. We design, code & deploy — webstores, websites, web apps. Packed solutions & custom designs for great user experiences.";
---

<Layout
  title={title}
  description={description}
  bodyClass="discoverablity"
>
  <Fragment slot="page_intro">
    <LandingScreen
      overtitle_line1={overtitle_line1}
      overtitle_line2={overtitle_line2}
      overtitle_line3={overtitle_line3}
      title={pageTitle}
      onScroll_line1={onScroll_line1}
      onScroll_line2={onScroll_line2}
      onScroll_line3={onScroll_line3}
      onScroll_line4={onScroll_line4}
      onScroll_line5={onScroll_line5}
      onScroll_line6={onScroll_line6}
    >
      <Icono width={133} height={133} fill="currentColor" />
    </LandingScreen>
  </Fragment>

  <Gmap />
</Layout>

<style is:global>
  /* Page tone — luma only, same brand hue/chroma. One step darker than
     showcase (the previous deepest), making this the darkest blue page.
     Footer untouched. NB: bodyClass is "discoverablity" (existing spelling). */
  body.discoverablity {
    --brand: oklch(0.4 0.24 255);
    --region_head: oklch(from var(--brand) 0.29 c h);
    --region_main: oklch(from var(--brand) 0.89 calc(c * 0.18) h);
  }
</style>
