---
//pages/discoverability.astro
import Layout from "@layouts/Layout.astro";
import Gmap from "@components/Gmap.astro";
import LandingScreen from "@components/HeaderAni2Black.astro";

// Page metadata
const pageTitle = "Junglestar | Pricing";
const pageSubtitle = "YOU'RE LOCATED where?";
const pageRevealOnScroll1 = "Do you get msg like:";
const pageRevealOnScroll2 = "''Can you send me your location, pls?''";
const pageRevealOnScroll3 = "How you deal with it? Traditionally it was:";
const pageRevealOnScroll4 = "''Follow me, I'll show you!''";
const pageRevealOnScroll5 = "What worked doesn't anymore, now what?";
const pageDescription =
  "Flexible one-stop web agency. We design, code & deploy — webstores, websites, web apps. Packed solutions & custom designs for great user experiences.";
---

<style>
  h1 {
    color: var(--black);
  }
</style>
<Layout title={pageTitle} description={pageDescription} pageSubtitle={pageSubtitle}>
  <LandingScreen>
    {pageSubtitle}
    <p class="brand small_text">
      {pageRevealOnScroll1}
      <br /><br />
      {pageRevealOnScroll2}
      <br /><br />
      {pageRevealOnScroll3}
      <br /><br />
      {pageRevealOnScroll4}
      <br /><br />
      {pageRevealOnScroll5}
    </p>
  </LandingScreen>
  <Gmap />
</Layout>
