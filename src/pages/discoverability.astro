---
//pages/discoverability.astro
import Layout from "@layouts/Layout.astro";
import Ani from "@components/UI/AnimHeader2Black.astro";
import Wave from "@components/UI/Wave.astro";
import LandingScreen from "@components/UI/LandingScreen.astro";

import Gmap from "@components/brand/Gmap.astro";

// Page metadata
const overtitle_line1 = "Marketing";
const overtitle_line2 = "Communication.";
const overtitle_line3 = "Simplified.";

const title_start = "Junglestar ";
const title_end = " Content Production";
const title = title_start + " | " + title_end;
const pageTitle = "YOU'RE LOCATED where?";

const onScroll_line1 = "Do you get msg like:";
const onScroll_line2 = "''Can you send me your location, pls?''";
const onScroll_line3 = "How you deal with it? as we always did like...";
const onScroll_line4 = "''Follow me, I'll show you!''";
const onScroll_line5 = "What worked doesn't anymore.";
const onScroll_line6 = "Now what?";
const description =
  "Flexible one-stop web agency. We design, code & deploy — webstores, websites, web apps. Packed solutions & custom designs for great user experiences.";
---

<style>
  h1 {
    color: var(--black);
  }
</style>

<Layout
  title={title}
  description={description}
  bodyClass="discoverablity bg_black"
  background="--black"
>
  <Ani>
    <LandingScreen
      overtitle_line1={overtitle_line1}
      overtitle_line2={overtitle_line2}
      overtitle_line3={overtitle_line3}
      title={pageTitle}
      onScroll_line1={onScroll_line1}
      onScroll_line2={onScroll_line2}
      onScroll_line3={onScroll_line3}
      onScroll_line4={onScroll_line4}
      onScroll_line5={onScroll_line5}
      onScroll_line6={onScroll_line6}
    />
  </Ani>

  <Wave color="var(--black)" position="top" />
  <Gmap />
  <Wave color="var(--black)" position="bottom" />

  <div class="space8"></div>
</Layout>
