---
// src/pages/index.astro
import Layout from "@layouts/Layout.astro";
import LandingScreen from "@components/UI/LandingScreen.astro";
import IntroSection from "@components/intro/IntroSection.astro";
import WaveSection from "@components/UI/WaveSection.astro";
import Icono from "@svgs/radio.svg";
import * as repoData from "package.json";

// Page metadata
const overtitle_line1 = "Your business, simplified.";
const overtitle_line2 = "Your life, upgraded. ";
const overtitle_line3 = "Trade grunt-work for free time!";

const title_start = "Junglestar ";
const title_end = " Sustainable Web Design";
const title = title_start + " | " + title_end + " | v" + repoData.version;

const onScroll_line1 = "Hello! Welcome.";
const onScroll_line2 = "Let us breifly introduce";
const onScroll_line3 = "WHAT WE CAN DO ";
const onScroll_line4 = "and";
const onScroll_line5 = "WHY YOU MIGHT NEED US";
const onScroll_line6 = "Keep on scrolling...";
const description =
  "Sustainable Web Design to help fight to help the planet. Change. We help small enterprises with websites, apps, and marketing communication.";
// const subtitle = "";

// Generate unique ID for clip-path
const clipId = `wave_${Math.random().toString(36).slice(2, 9)}`;
// waveHeight?: number; // 0-1, where the wave starts (default 0.7 = 70% from top)
const waveHeight = 0.9;
// Build wave path with configurable height
const wavePath = `M0,0 L1,0 L1,${waveHeight} Q0.75,${waveHeight + 0.15} 0.5,${waveHeight} Q0.25,${waveHeight - 0.15} 0,${waveHeight} Z`;
---

<style>
  .brand_name {
    padding-top: calc(var(--space_block) * 3);
  }
  .intros {
    background-color: red;
    padding-block: 1rem;
    clip-path: `${wavePath}`;
  }
</style>

<Layout
  title={title}
  description={description}
  bodyClass="index bg_brand"
  mainClass=" "
  background="--brand"
>
  <svg width="0" height="0" aria-hidden="true">
    <defs>
      <clipPath id={clipId} clipPathUnits="objectBoundingBox">
        <path d={wavePath}></path>
      </clipPath>
    </defs>
  </svg>

  <Fragment slot="inside_header">
    <LandingScreen
      title={title_start}
      overtitle_line1={overtitle_line1}
      overtitle_line2={overtitle_line2}
      overtitle_line3={overtitle_line3}
      onScroll_line1={onScroll_line1}
      onScroll_line2={onScroll_line2}
      onScroll_line3={onScroll_line3}
      onScroll_line5={onScroll_line5}
      onScroll_line6={onScroll_line6}
    >
      <Icono width={133} height={133} fill="currentColor" />
    </LandingScreen>
  </Fragment>


    <IntroSection />

</Layout>
