---
// src/pages/index.astro
import Layout from "@layouts/Layout.astro";
import LandingScreen from "@components/UI/HeaderAni2Black.astro";
import AutoContrast from "@components/UI/AutoContrast.astro";
import IntroSection from "@components/intro/IntroSection.astro";
import * as repoData from "package.json";

// Page metadata
const title_start = "Junglestar ";
const title_end = " Sustainable Web Design";
const title = title_start + repoData.version + title_end;
const pageSubtitle_line1 = "Your business, simplified.";
const pageSubtitle_line2 = "Your life, upgraded. ";
const pageSubtitle_line3 = "Trade grunt-work for free time!";
const onScroll_line1 = "Hello!";
const onScroll_line2 = "Welcome.";
const onScroll_line3 = "Let us breifly introduce";
const onScroll_line4 = "what we can do";
const onScroll_line5 = "for small entrepreneurs.";
const onScroll_line6 = "Keep on scrolling...";
const description =
  "Sustainable Web Design to help fight to help the planet. Change. We help small enterprises with websites, apps, and marketing communication.";
// const subtitle = "";
---

<style>
  .overline {
    font-size: 70%;
  }
  .brand_name {
    padding-top: calc(var(--space_block) * 1);
    font-size: 133%;
  }
</style>
<Layout
  title={title}
  description={description}
>
  <LandingScreen>
    <div class="title_wrap">
      <div class="overline line1">{pageSubtitle_line1}</div>
      <div class="overline line2">{pageSubtitle_line2}</div>
      <div class="overline line3">{pageSubtitle_line3}</div>
      <div class="brand_name">
        {title_start}
      </div>
    </div>

    <p class="brand small_text">
      {onScroll_line1.toUpperCase()}
      <br />
      {onScroll_line2}
      <br /><br />
      {onScroll_line3}
      <br />
      {onScroll_line4}
      <br />
      {onScroll_line5}
      <br /><br />
      {onScroll_line6}
    </p>
  </LandingScreen>
  <!-- <AutoContrast backgroundColor="black">
    <IntroSection />
  </AutoContrast> -->

  <AutoContrast
    id="progress-box"
    class="h-64"
    data-scroll-colors='["oklch(0 0 0)","oklch(0 0 0)", "oklch(0.8286 0.1735 255)","oklch(0.8286 0.1735 255)",  "oklch(0.5286 0.1735 255)",  "oklch(0.5286 0.1735 255)"]'
  >
    <IntroSection />
  </AutoContrast>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLElement>("[data-scroll-colors]")
      .forEach((box) => {
        const colors: string[] = JSON.parse(box.dataset.scrollColors || "[]");
        if (colors.length === 0) return;

        const updateColor = () => {
          const rect = box.getBoundingClientRect();
          const windowHeight = window.innerHeight;

          // Progress: 0 when element top enters viewport bottom
          //           1 when element bottom reaches viewport top
          const start = windowHeight; // element top at viewport bottom
          const end = -rect.height; // element bottom at viewport top
          const progress = Math.max(
            0,
            Math.min(1, (start - rect.top) / (start - end)),
          );

          const index = Math.min(
            Math.floor(progress * colors.length),
            colors.length - 1,
          );
          (box as any).setBackgroundColor(colors[index]);
        };

        window.addEventListener("scroll", updateColor, { passive: true });
        document.addEventListener("scroll", updateColor, { passive: true });
        document.body.addEventListener("scroll", updateColor, {
          passive: true,
        });

        const main = document.querySelector("main");
        if (main)
          main.addEventListener("scroll", updateColor, { passive: true });

        updateColor();
      });
  });
</script>
