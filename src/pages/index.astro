---
// src/pages/index.astro
import Layout from "@layouts/Layout.astro";
import LandingScreen from "@components/UI/LandingScreen.astro";
import IntroSection from "@components/intro/IntroSection.astro";
import Icono from "@svgs/radio.svg";

// Page metadata
const overtitle_line1 = "Your business, simplified. Your life, upgraded.";
const overtitle_line2 = "";
const overtitle_line3 = "Trade grunt-work for free time!";

const title_start = "Junglestar ";
const title_end = " Sustainable Web Design";
const title = title_start + " | " + title_end;
const h1= 'One-stop-shop for small companies communication needs.';

const onScroll_line1 = "Let us briefly introduce what we can do for you and why you might need us...";
const description =
  "Sustainable Web Design to help fight climate change. We help small enterprises with websites, apps, and marketing communication.";
// const subtitle = "";

---

<style>
  /* Homepage main is dark: the intro SVGs are drawn for a black canvas.
     Scoped to the home page only — the rest of the site keeps the
     near-white main from the region ramp. */
  :global(body.index main) {
    background-color: var(--black);
    color: var(--white);
  }

  /* Home has no banded h1, so its hero icon uses the footer tint
     (--region_foot) instead of the page master — light on the deep hero. */
  :global(body.index .landing_screen svg) {
    color: var(--region_foot);
  }
</style>

<Layout
  title={title}
  description={description}
  bodyClass="index"
>

  <Fragment slot="page_intro">
    <LandingScreen
      title={h1}
      overtitle_line1={overtitle_line1}
      overtitle_line2={overtitle_line2}
      overtitle_line3={overtitle_line3}
      onScroll_line1={onScroll_line1}
    >
      <Icono width={133} height={133} fill="currentColor" />
    </LandingScreen>
  </Fragment>


    <IntroSection />

</Layout>
