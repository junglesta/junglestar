---
// src/pages/offer.astro
import Layout from "@layouts/Layout.astro";
import Gmap from "@components/brand/Gmap.astro";
import SlowWebsite from "@components/brand/SlowWebsite.astro";
import Icono from "@svgs/feather.svg";
import LandingScreen from "@components/UI/LandingScreen.astro";
import CTAButton from "@components/UI/CTAMailBanner.astro";

import { getCollection } from "astro:content";
// Fetch all offers from the collection
const allOffers = await getCollection("offers", ({ data }) => data.publish);

// Sort: bestvalue first, then bestseller, then others
const offers = allOffers.sort((a, b) => {
  if (a.data.bestvalue) return -1;
  if (b.data.bestvalue) return 1;
  if (a.data.bestseller) return -1;
  if (b.data.bestseller) return 1;
  return 0;
});

// Page metadata
const overtitle_line1 = "Pricing, simplified. You need a new website! We design, code, deploy & mantain it for a monthly fee. End of worries!";
const overtitle_line2 = "";
const overtitle_line3 = "";

const title_start = "Junglestar ";
const title_end = " Pricing";
const title_page = "packaged websites & custom designs";
const title = title_start + " | " + title_end;

const onScroll_line1 = "";
const onScroll_line2 = "";
const onScroll_line3 = "";
const onScroll_line4 = "";
const onScroll_line5 = "";
const onScroll_line6 = "Junglestar offers All-included solutions. We make websites, webstores & web apps. Visual Menus for Bars & Restaurants! Packed Solutions & Custom Designs.";
const description =
  "Flexible one-stop web agency. We make webstores & web apps. Packed solutions & custom designs for great user experiences.";
---

<style>
  .offer_content {
    padding: 0;
  }

  .offer_content :is(h1, h2, h3, h4, h5, h6, .h1, .h2, .h3, .h4, .h5, .h6) {
    color: var(--brand);

  }

  /* Section band over the pricing grid. This page is the dark end of the blue
     ramp, so the default brand-coloured band blends into its surroundings —
     use a LIGHT blue tint here so it stands out, with the heading in the dark
     brand colour (readable on the light band). */
  .section_band {
    background-color: oklch(from var(--brand) 0.88 calc(c * 0.45) h);
  }
  .section_band .offers_title {
    color: var(--brand);
  }
  .grid_offer_color {
    background-color: rgba(0, 0, 0, 0.15);
  }
  .grid_offer {
    padding-block: calc(var(--space_block) * 2.33);
    padding-inline: var(--space_inline);
    display: grid;
    align-items: stretch;
    gap: calc(var(--space_block) * 1.5);
    grid-template-columns: 1fr;
    max-width: 500px;
    margin-inline: auto;
    margin-top: calc(var(--space_block) * 2);
  }

  @media (width > 600px) {
    .grid_offer {
      padding-inline: calc(var(--space_inline) * 3);
    }
  }

  @media (width > 820px) {
    .grid_offer {
      max-width: 1200px;
      padding-inline: var(--space_inline);
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .grid_offer_card {
    background-color: var(--white);
    margin-block: calc(var(--space_block) / 2);
    padding-inline: clamp(16px, 3vw, 32px);
    border: 1px var(--brand) solid;
    border-radius: var(--radius);
    display: grid;
    align-items: self-end;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto 1fr auto auto;
    gap: 18px;
    grid-template-areas:
      "header"
      "desc"
      "benefits"
      "price"
      "footer";

    h3,
    .h3 {
      padding-top: calc(var(--space_block) * 0.5);
      padding-bottom: calc(var(--space_block) * 0.5);
      margin-bottom: 0;
      font-size: calc(var(--font_rem) * 1.15);
    }
    h2,
    .h2 {
      padding-top: calc(var(--space_block) * 0.5);
      padding-bottom: calc(var(--space_block) * 0.5);
      margin-bottom: 0;
      font-size: calc(var(--font_rem) * 1.3);
    }
    h4,
    .h4 {
      font-size: calc(var(--font_rem) * 1.1);
      padding: 0;
      margin: 0;
    }
  }

  .offer_top {
    grid-area: header;
    padding-top: calc(var(--space_block) * 0.75);
  }
  .offer_desc {
    grid-area: desc;
    text-wrap: pretty;
    line-height: 1.15;
    padding-inline: calc(var(--space_inline) * 0.75);
    padding-bottom: calc(var(--space_block) * 0.5);
  }
  .offer_benefits {
    grid-area: benefits;
    text-align: left;
    /*padding-left: calc(var(--space_inline) * 0.25);*/
    /*padding-right: calc(var(--space_inline) * 0.5);*/
  }
  .offer_price {
    grid-area: price;
    p {
      margin-bottom: 0;
    }
  }
  .offer_footer {
    grid-area: footer;
    align-self: end;
    justify-self: center;
    padding-bottom: calc(var(--space_block) * 1.33);
  }

  /* Recommended tier wins: thicker accent border + elevation */
  .grid_offer_card.bestseller {
    border: 2px solid var(--brand);
    box-shadow: var(--card_shadow_hover);
  }
  .grid_offer_card.bestvalue {
    border: 1.5px solid var(--brand-300);
  }

  @media (width > 820px) {
    .grid_offer_card.bestseller {
      transform: scale(1.04);
      z-index: 1;
    }
  }

  /* Category label as a pill badge on every tier (outlined by default) */
  .grid_offer_card .offer_top > p {
    display: block;
    width: fit-content;
    margin-inline: auto;
    padding: 0.15em 0.9em;
    border-radius: 999px;
    border: 1.5px solid var(--brand);
    font-size: calc(var(--font_rem) * 0.6);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--brand) !important;
  }
  /* Recommended tiers get a filled badge */
  .grid_offer_card.bestseller .offer_top > p {
    background-color: var(--brand);
    border-color: var(--brand);
    color: var(--white) !important;
  }
  .grid_offer_card.bestvalue .offer_top > p {
    background-color: var(--brand-300);
    border-color: var(--brand-300);
    color: var(--white) !important;
  }

  .color_black {
    color: var(--black);
  }

  .button_row {
    a {
      color: var(--brand);
      text-decoration: none;
    }
  }

  .whatsincluded,
  .fontsize_med {
    font-size: calc(var(--font_rem) * 0.75);
    font-weight: 500;
  }

  .fontsize_sm {
    font-size: calc(var(--font_rem) * 0.55);
    font-weight: 500;
  }

  .starting_at {
    padding-top: calc(var(--space_block) * 0.5);
    font-size: calc(var(--font_rem) * 0.75);
    font-weight: 500;
  }

  .demo_link {
    padding-bottom: 0;
    font-size: calc(var(--font_rem) * 0.75);
    font-weight: 300;
  }

  .included {
    padding-top: calc(var(--space_block) / 2);
  }

  .offers_title {
    text-align: center;
    text-wrap: balance;
    text-transform: uppercase !important;
    padding-top: calc(var(--space_block) * 2);
    padding-inline: var(--space_inline);
    max-width: 800px;
    margin-inline: auto;
  }


</style>

<Layout
  title={title}
  description={description}
  bodyClass="offer"
>
  <Fragment slot="page_intro">
    <LandingScreen
      overtitle_line1={overtitle_line1}
      overtitle_line2={overtitle_line2}
      overtitle_line3={overtitle_line3}
      title={title_page}
      onScroll_line1={onScroll_line1}
      onScroll_line2={onScroll_line2}
      onScroll_line3={onScroll_line3}
      onScroll_line4={onScroll_line4}
      onScroll_line5={onScroll_line5}
      onScroll_line6={onScroll_line6}
    >
      <Icono width={133} height={133} fill="currentColor" />
    </LandingScreen>
  </Fragment>

  <div class="print_only">
    <div class="print_imperatif">Make life easy for your customers!</div>
    <div class="print_title">Junglestar</div>
    <div class="print_subtitle">
      Junglestar can make you a fast-loading website, crafted to out-perform
      your competitors.
    </div>
  </div>

  <div class="offer_content grid_offer_color">
    <SlowWebsite />

    <div class="section_band">
      <div class="h3 offers_title center wrap">
        We offer all-inclusive packages for any budget!
      </div>
    </div>
    <div class="grid_offer">
      {
        offers.map((offer) => {
          const { data } = offer;
          const { product, selling_points } = data;
          const cardClasses = [
            "grid_offer_card",
            data.bestvalue && "bestvalue",
            data.bestseller && "bestseller",
          ]
            .filter(Boolean)
            .join(" ");

          return (
            <div
              id={data.slug}
              class={cardClasses}
              title={`${data.name.toUpperCase()} package`}
            >
              <header class="offer_top">
                <h2 class="center">{product.name}</h2>
                <p class="center color_black">{product.type} </p>
                <h3 class="h3 center">
                  {product.subname}
                  <br />
                  <small class="fontsize_sm">
                    1 year included, then €55/yr.
                  </small>
                </h3>
              </header>

              <div class="offer_desc">{product.desc}</div>

              <div class="offer_benefits selling_points">
                <div class="center brand fontsize_med">What's included:</div>

                <ul class="included">
                  {Object.values(selling_points).map((point) => (
                    <li class="checkmark">{point}</li>
                  ))}
                </ul>
              </div>

              <div class="offer_price fontsize_med center">
                <p class="fontsize_med center">
                  Starting at {product.starting_at} Euro.
                </p>
                <p class="brand fontsize_sm">One time cost!</p>
                <p>
                  <a
                    class="demo_link fontsize_med center"
                    title={`See - ${product.name} Demo`}
                    href={product.demo_url}
                  >
                    See Demo.
                  </a>
                </p>
              </div>
            </div>
          );
        })
      }
    </div>
    <footer class="offer_footer">
      <CTAButton />
    </footer>
  </div>

  <Gmap />

  <div class="print_only">
    <div class="print_footer">
      See this offer online at: https://junglestar.org/offer/
    </div>
  </div>
</Layout>

<style is:global>
  /* Page tone — luma only, same brand hue/chroma. Two notches darker than the
     default blue (between showcase and design). Footer untouched. */
  body.offer {
    --brand: oklch(0.48 0.24 255);
    --region_head: oklch(from var(--brand) 0.37 c h);
    --region_main: oklch(from var(--brand) 0.94 calc(c * 0.18) h);
  }
</style>
