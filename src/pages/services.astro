---
// src/pages/services.astro
import Header from "@components/UI/AnimHeader2OffWhite.astro";
import Layout from "@layouts/Layout.astro";

// Page metadata
const pageTitle = "Junglestar | Services";
const description =
  "Sustainable Web Design to help fight to help the planet. Change. We help small enterprises with websites, apps, and marketing communication.";
const pageSubtitle = "Current Services";
---

<Layout
  title={pageTitle}
  description={description}
  bodyClass="services bg_white"
  background="--white"
>
  <div slot="landing_screen">
    <Header>{pageSubtitle}</Header>
  </div>

  <main class="wrap">
    <h1>Our Services</h1>
    <p>Content coming soon.</p>
  </main>
</Layout>
