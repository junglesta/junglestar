---
// src/pages/sty.astro — Design System / Style Guide
// Rebuilt as a DX-oriented reference: every token is a click-to-copy chip,
// rendered live for visual QA. Hidden from crawlers (sitemap=false).
import Layout from "@layouts/Layout.astro";
import AutoContrast from "@components/UI/AutoContrast.astro";

const title = "Style Guide";
const description = "Junglestar design system — tokens, type, spacing & components.";

// ── COLOUR TOKENS ──────────────────────────────────────────────────────────
const brandScale = [
  "--brand-50", "--brand-100", "--brand-200", "--brand-300", "--brand-400",
  "--brand-500", "--brand-600", "--brand-700", "--brand-800", "--brand-900",
];
const brandCore = ["--brand", "--brandT25", "--brandT50", "--brandT75"];
const greenRamp = ["--jgreen_lightest", "--jgreen_light", "--jgreen", "--jgreen_dark", "--jgreen_darker"];
const orangeRamp = ["--jorange_lightest", "--jorange_light", "--jorange", "--jorange_dark", "--jorange_darker"];
const whites = ["--white", "--whiteOFF", "--whiteDIRTY"];
const blacks = [
  "--grey_color_lightest",
  "--grey_color_lighter", "--grey_color_light", "--grey_color", "--grey_color_dark",
  "--black_fumes", "--black",
];
const alphaWhite = ["--whiteT50", "--whiteT25", "--whiteT15", "--whiteT10", "--whiteT05"];
const alphaBlack = ["--blackT75", "--blackT50", "--blackT30", "--blackT15", "--blackT10", "--blackT05"];
// Per-page region ramp (resolves to this page's master — blue here).
const regions = ["--region_head", "--region_main", "--region_foot"];
const semantic = ["--text_color", "--link_color", "--link_color_main", "--background_color"];

// Resolved values for display (mirrors tokens.css; brand scale/regions are the
// concrete result of the OKLCH relative-colour formulas for the default brand).
const tokenValues: Record<string, string> = {
  "--brand-50": "oklch(0.97 0.053 255)",
  "--brand-100": "oklch(0.93 0.096 255)",
  "--brand-200": "oklch(0.85 0.156 255)",
  "--brand-300": "oklch(0.75 0.204 255)",
  "--brand-400": "oklch(0.66 0.24 255)",
  "--brand-500": "oklch(0.57 0.24 255)",
  "--brand-600": "oklch(0.48 0.24 255)",
  "--brand-700": "oklch(0.4 0.24 255)",
  "--brand-800": "oklch(0.32 0.216 255)",
  "--brand-900": "oklch(0.24 0.168 255)",
  "--brand": "oklch(0.57 0.24 255)",
  "--brandT25": "oklch(0.57 0.24 255 / 25%)",
  "--brandT50": "oklch(0.57 0.24 255 / 50%)",
  "--brandT75": "oklch(0.57 0.24 255 / 75%)",
  "--jgreen_lightest": "oklch(0.98 0.12 144)",
  "--jgreen_light": "oklch(0.96 0.31 144)",
  "--jgreen": "oklch(0.74 0.31 144)",
  "--jgreen_dark": "oklch(0.54 0.31 144)",
  "--jgreen_darker": "oklch(0.29 0.31 144)",
  "--jorange_lightest": "oklch(0.98 0.1 45)",
  "--jorange_light": "oklch(0.97 0.23 45)",
  "--jorange": "oklch(0.79 0.16 45)",
  "--jorange_dark": "oklch(0.58 0.16 45)",
  "--jorange_darker": "oklch(0.48 0.16 45)",
  "--white": "oklch(0.9624 0.0062 75.41)",
  "--whiteOFF": "oklch(0.95 0.02 75.4)",
  "--whiteDIRTY": "oklch(0.88 0.02 75.4)",
  "--black": "oklch(0 0 0)",
  "--black_fumes": "#161616",
  "--grey_color_lightest": "oklch(0.88 0 0)",
  "--grey_color_lighter": "#888888",
  "--grey_color_light": "#646464",
  "--grey_color": "#343434",
  "--grey_color_dark": "#232323",
  "--whiteT50": "rgb(255 255 255 / 50%)",
  "--whiteT25": "rgb(255 255 255 / 25%)",
  "--whiteT15": "rgb(255 255 255 / 15%)",
  "--whiteT10": "rgb(255 255 255 / 10%)",
  "--whiteT05": "rgb(255 255 255 / 5%)",
  "--blackT75": "rgb(0 0 0 / 75%)",
  "--blackT50": "rgb(0 0 0 / 50%)",
  "--blackT30": "rgb(0 0 0 / 30%)",
  "--blackT15": "rgb(0 0 0 / 15%)",
  "--blackT10": "rgb(0 0 0 / 10%)",
  "--blackT05": "rgb(0 0 0 / 5%)",
  "--region_head": "oklch(0.45 0.24 255)",
  "--region_main": "oklch(0.97 0.043 255)",
  "--region_foot": "oklch(0.9 0.096 255)",
  "--text_color": "#111111",
  "--link_color": "oklch(0.9624 0.0062 75.41)",
  "--link_color_main": "oklch(0 0 0)",
  "--background_color": "oklch(0.9624 0.0062 75.41)",
};

// ── TYPE ─────────────────────────────────────────────────────────────────────
const headings = [
  { tag: "h1", weight: "--h1-weight" },
  { tag: "h2", weight: "--h2-weight" },
  { tag: "h3", weight: "--h3-weight" },
  { tag: "h4", weight: "--h4-weight" },
  { tag: "h5", weight: "--h5-weight" },
  { tag: "h6", weight: "--h6-weight" },
];
const weights = [
  { token: "--weight_thinner", val: 100 },
  { token: "--weight_thin", val: 200 },
  { token: "--weight", val: 300 },
  { token: "--weight_med", val: 400 },
  { token: "--weight_bold", val: 600 },
  { token: "--weight_heavy", val: 900 },
];

// ── SPACING / RADIUS / SHADOW ─────────────────────────────────────────────────
const spacing = [
  { token: "--space_block", val: "1.75rem" },
  { token: "--space_inline", val: "1.25rem" },
  { token: "--tap_size", val: "44px" },
];
const shadows = ["--card_shadow", "--card_shadow_hover", "--main_shadow", "--header_shadow"];

// ── COMPONENT CLASSES ─────────────────────────────────────────────────────────
const buttons = [".button", ".cta", ".button_dark"];

// Demo cards for the .card_list bento grid
const demoCards = [
  { title: "Sustainable design", sub: "Build for the long run" },
  { title: "Content production", sub: "Your brand narrative" },
  { title: "Discoverability", sub: "Be found" },
  { title: "Open source", sub: "Own your stack" },
];

// Layout utility classes — a representative few (not the whole set)
const utilities = [".wrap", ".center", ".reader_friendly", ".flex", ".flex_cols", ".flex_align_center"];

// Aspect-ratio tiers (landscape.css): label, ratio range, typical devices
const aspectTiers = [
  ["Portrait", "< 1", "phones / tablets portrait"],
  ["Square", "1 – 4/3", "tablets, some monitors"],
  ["Landscape", "4/3 – 16/9", "most laptops, monitors"],
  ["Wide", "16/9 – 21/9", "TVs, wide monitors"],
  ["Ultra-wide", "> 21/9", "ultrawide, multi-screen"],
];
// Tokens the tiers re-tune + a few landscape-aware utilities
const aspectTokens = ["--is_landscape", "--section_height", "--section_height_half", "--safe_inset", "--safe_padding"];
const landscapeUtils = [".tv-safe", ".section-height", ".container-inline", ".space-between-adaptive"];
const printClasses = [".print_only", ".print_title", ".print_footer", ".top_pad_big"];
const autocontrastBgs = ["var(--white)", "var(--black)", "var(--brand)", "var(--jorange)", "var(--jgreen)"];

// AutoContrast docs — code examples (rendered as literal text)
const acCssExample = `/* Native CSS Color 6 — picks black or white,
   whichever contrasts the given colour best. */
.badge {
  background: var(--brand);
  color: contrast-color(var(--brand));
}`;
const acAstroExample = `${"---"}
import AutoContrast from "@components/UI/AutoContrast.astro";
${"---"}
<!-- Native where supported; JS luminance fallback elsewhere -->
<AutoContrast backgroundColor="var(--brand)">
  Always-readable label
</AutoContrast>

<!-- Optional props (lightText / darkText / threshold
     only affect the JS fallback) -->
<AutoContrast
  backgroundColor="#ff9900"
  tag="span"
  lightText="white"
  darkText="black"
  threshold={0.32}
>
  Pill
</AutoContrast>`;
const acSupportExample = `/* Progressive enhancement, both ship together */
@supports (color: contrast-color(red)) {
  .auto-contrast { color: contrast-color(var(--bg-color)); }
}
@supports not (color: contrast-color(red)) {
  .auto-contrast { color: var(--text-color); } /* JS sets it */
}`;

const sections = [
  ["colour", "Colour"],
  ["type", "Type"],
  ["space", "Spacing"],
  ["elevation", "Radius & Shadow"],
  ["components", "Components"],
  ["system", "System"],
];
---

<Layout title={title} description={description} bodyClass="styleguide" sitemap={false}>
  <main class="sg wrap">
    <header class="sg_head">
      <h1>Design System</h1>
      <p class="sg_lead">
        Live reference for Junglestar's tokens, type scale and components.
        <strong>Click any chip to copy its <code>var()</code> reference.</strong>
      </p>
    </header>

    <!-- Sibling of <main>'s sections (not nested in the short header) so the
         sticky travels the whole page on desktop instead of releasing at once. -->
    <nav class="sg_nav" aria-label="Sections">
      {sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
    </nav>

    <!-- ══ COLOUR ══════════════════════════════════════════════════════ -->
    <section id="colour" class="sg_section">
      <h2>Colour</h2>

      <h3>Brand scale</h3>
      <p class="sg_note">Derived from a single <code>--brand</code> via OKLCH relative colour (50 lightest → 900 darkest).</p>
      <div class="sg_swatches">
        {brandScale.map((t) => (
          <button class="swatch" type="button" data-copy={`var(${t})`}>
            <span class="swatch_color" style={`background:var(${t})`}></span>
            <code class="swatch_name">{t}</code>
            {tokenValues[t] && <span class="swatch_value">{tokenValues[t]}</span>}
          </button>
        ))}
      </div>

      <h3>Brand &amp; transparents</h3>
      <div class="sg_swatches">
        {brandCore.map((t) => (
          <button class="swatch" type="button" data-copy={`var(${t})`}>
            <span class="swatch_color checkered" style={`background:var(${t})`}></span>
            <code class="swatch_name">{t}</code>
            {tokenValues[t] && <span class="swatch_value">{tokenValues[t]}</span>}
          </button>
        ))}
      </div>

      <h3>Harmonizers — Green</h3>
      <div class="sg_swatches">
        {greenRamp.map((t) => (
          <button class="swatch" type="button" data-copy={`var(${t})`}>
            <span class="swatch_color" style={`background:var(${t})`}></span>
            <code class="swatch_name">{t}</code>
            {tokenValues[t] && <span class="swatch_value">{tokenValues[t]}</span>}
          </button>
        ))}
      </div>

      <h3>Harmonizers — Orange</h3>
      <div class="sg_swatches">
        {orangeRamp.map((t) => (
          <button class="swatch" type="button" data-copy={`var(${t})`}>
            <span class="swatch_color" style={`background:var(${t})`}></span>
            <code class="swatch_name">{t}</code>
            {tokenValues[t] && <span class="swatch_value">{tokenValues[t]}</span>}
          </button>
        ))}
      </div>

      <h3>Whites</h3>
      <div class="sg_swatches">
        {whites.map((t) => (
          <button class="swatch" type="button" data-copy={`var(${t})`}>
            <span class="swatch_color bordered" style={`background:var(${t})`}></span>
            <code class="swatch_name">{t}</code>
            {tokenValues[t] && <span class="swatch_value">{tokenValues[t]}</span>}
          </button>
        ))}
      </div>

      <h3>Blacks &amp; greys</h3>
      <div class="sg_swatches">
        {blacks.map((t) => (
          <button class="swatch" type="button" data-copy={`var(${t})`}>
            <span class="swatch_color bordered" style={`background:var(${t})`}></span>
            <code class="swatch_name">{t}</code>
            {tokenValues[t] && <span class="swatch_value">{tokenValues[t]}</span>}
          </button>
        ))}
      </div>

      <h3>Alpha — white</h3>
      <div class="sg_swatches">
        {alphaWhite.map((t) => (
          <button class="swatch" type="button" data-copy={`var(${t})`}>
            <span class="swatch_color checkered" style={`background:var(${t})`}></span>
            <code class="swatch_name">{t}</code>
            {tokenValues[t] && <span class="swatch_value">{tokenValues[t]}</span>}
          </button>
        ))}
      </div>

      <h3>Alpha — black</h3>
      <div class="sg_swatches">
        {alphaBlack.map((t) => (
          <button class="swatch" type="button" data-copy={`var(${t})`}>
            <span class="swatch_color checkered" style={`background:var(${t})`}></span>
            <code class="swatch_name">{t}</code>
            {tokenValues[t] && <span class="swatch_value">{tokenValues[t]}</span>}
          </button>
        ))}
      </div>

      <h3>Region ramp &amp; semantic</h3>
      <p class="sg_note">Region tokens resolve from this page's master (blue). Each page re-tunes them.</p>
      <div class="sg_swatches">
        {regions.concat(semantic).map((t) => (
          <button class="swatch" type="button" data-copy={`var(${t})`}>
            <span class="swatch_color bordered" style={`background:var(${t})`}></span>
            <code class="swatch_name">{t}</code>
            {tokenValues[t] && <span class="swatch_value">{tokenValues[t]}</span>}
          </button>
        ))}
      </div>
    </section>

    <!-- ══ TYPE ════════════════════════════════════════════════════════ -->
    <section id="type" class="sg_section">
      <h2>Type</h2>

      <h3>Heading scale</h3>
      <div class="sg_type_list">
        {headings.map(({ tag, weight }) => {
          const Tag = tag;
          return (
            <div class="sg_type_row">
              <Tag class="sg_type_sample">Junglestar — {tag.toUpperCase()}</Tag>
              <button class="chip" type="button" data-copy={`var(${weight})`}>
                <code>{weight}</code>
              </button>
            </div>
          );
        })}
      </div>

      <h3>Weights</h3>
      <div class="sg_type_list">
        {weights.map(({ token, val }) => (
          <div class="sg_type_row">
            <span class="sg_weight_sample" style={`font-weight:${val}`}>
              The smart dev-opx — {val}
            </span>
            <button class="chip" type="button" data-copy={`var(${token})`}>
              <code>{token}</code>
            </button>
          </div>
        ))}
      </div>

      <h3>Body &amp; font tokens</h3>
      <p class="sg_body_sample">
        Body copy uses <code>--font_clamp</code> over <code>--font_family</code> at
        <code>--line_height</code>. It's a jungle out there — we design, code &amp; deploy.
      </p>
      <div class="sg_chips">
        {["--font_family", "--font_clamp", "--font_rem", "--line_height"].map((t) => (
          <button class="chip" type="button" data-copy={`var(${t})`}><code>{t}</code></button>
        ))}
      </div>
    </section>

    <!-- ══ SPACING ═════════════════════════════════════════════════════ -->
    <section id="space" class="sg_section">
      <h2>Spacing</h2>
      <div class="sg_space_list">
        {spacing.map(({ token, val }) => (
          <button class="sg_space_row" type="button" data-copy={`var(${token})`}>
            <span class="sg_space_bar" style={`inline-size:var(${token})`}></span>
            <code class="sg_space_name">{token}</code>
            <span class="sg_space_val">{val}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- ══ RADIUS & SHADOW ═════════════════════════════════════════════ -->
    <section id="elevation" class="sg_section">
      <h2>Radius &amp; Shadow</h2>

      <h3>Radius</h3>
      <div class="sg_swatches">
        <button class="swatch" type="button" data-copy="var(--radius)">
          <span class="swatch_box radius_demo"></span>
          <code class="swatch_name">--radius</code>
        </button>
      </div>

      <h3>Shadows</h3>
      <div class="sg_shadows">
        {shadows.map((t) => (
          <button class="sg_shadow" type="button" data-copy={`var(${t})`}>
            <span class="sg_shadow_box" style={`box-shadow:var(${t})`}></span>
            <code class="swatch_name">{t}</code>
            {tokenValues[t] && <span class="swatch_value">{tokenValues[t]}</span>}
          </button>
        ))}
      </div>
    </section>

    <!-- ══ COMPONENTS ══════════════════════════════════════════════════ -->
    <section id="components" class="sg_section">
      <h2>Components</h2>

      <h3>Buttons</h3>
      <p class="sg_note">Hover to see states. Chips copy the class name.</p>
      <div class="sg_buttons">
        {buttons.map((cls) => (
          <div class="sg_button_cell">
            <span class:list={["button", cls.replace(".", "")]}>{cls}</span>
            <button class="chip" type="button" data-copy={cls}><code>{cls}</code></button>
          </div>
        ))}
      </div>

      <h3>Links</h3>
      <p class="sg_note">Body links use the main-region link colour; hover/underline come from the global link styles.</p>
      <p class="sg_links_demo">
        Here is an <a href="#colour">inline link</a> inside body copy, plus a second
        <a href="#type">link example</a> so you can check the underline and hover state.
      </p>
      <div class="sg_chips">
        {["--link_color", "--link_color_hover", "--link_color_main", "--link_color_main_hover"].map((t) => (
          <button class="chip" type="button" data-copy={`var(${t})`}><code>{t}</code></button>
        ))}
      </div>

      <h3>Card grid · <code>.card_list</code></h3>
      <p class="sg_note">The bento grid with <code>.card_link</code> items — hover for the arrow nudge &amp; icon scale.</p>
      <div class="card_list sg_card_grid">
        {demoCards.map((c) => (
          <a href="#components" class="card_link">
            <div class="post_image">
              <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M8 12l3 3 5-6"></path>
              </svg>
            </div>
            <div class="post_header">
              <h3 class="post_title">{c.title}</h3>
              <p class="post_subtitle">{c.sub}&ensp;<span class="card_arrow">&rarr;</span></p>
            </div>
          </a>
        ))}
      </div>

      <h3>Responsive grid · <code>.grid_projects</code></h3>
      <p class="sg_note">1 → 2 → 3 → 4 columns as the viewport grows (500 / 900 / 1400px).</p>
      <div class="grid_projects sg_grid_demo">
        {Array.from({ length: 8 }).map((_, i) => <div class="sg_cell">{i + 1}</div>)}
      </div>

      <h3>Layout utilities</h3>
      <p class="sg_note">Reusable helper classes — click to copy.</p>
      <div class="sg_chips">
        {utilities.map((c) => (
          <button class="chip" type="button" data-copy={c}><code>{c}</code></button>
        ))}
      </div>
    </section>

    <!-- ══ SYSTEM ═══════════════════════════════════════════════════════ -->
    <section id="system" class="sg_section">
      <h2>System</h2>

      <h3>Aspect-ratio tiers</h3>
      <p class="sg_note">Layout adapts to the viewport's aspect ratio (<code>landscape.css</code>), re-tuning the tokens below. Resize / rotate to watch the live readout change.</p>
      <div class="sg_tiers">
        {aspectTiers.map(([name, range, devices]) => (
          <div class="sg_tier">
            <strong>{name}</strong>
            <code>{range}</code>
            <span>{devices}</span>
          </div>
        ))}
      </div>
      <p class="sg_live">
        Current: <code id="sg_landscape">--is_landscape: …</code>
        <code id="sg_secheight">--section_height: …</code>
      </p>
      <div class="sg_chips">
        {aspectTokens.map((t) => (
          <button class="chip" type="button" data-copy={`var(${t})`}><code>{t}</code></button>
        ))}
      </div>
      <p class="sg_note">Landscape-aware utilities (a few of them):</p>
      <div class="sg_chips">
        {landscapeUtils.map((c) => (
          <button class="chip" type="button" data-copy={c}><code>{c}</code></button>
        ))}
      </div>

      <h3>Base print styles</h3>
      <p class="sg_note">A dedicated print layer (last in the cascade) swaps to a white canvas and reveals print-only blocks. Press <kbd>⌘ / Ctrl + P</kbd> to preview. Print helpers:</p>
      <div class="sg_chips">
        {printClasses.map((c) => (
          <button class="chip" type="button" data-copy={c}><code>{c}</code></button>
        ))}
      </div>

      <h3>AutoContrast <span class="sg_badge">ready · unused</span></h3>
      <p class="sg_note">
        <code>contrast-color()</code> is a new CSS Color&nbsp;6 function: given any colour it returns
        the colour (black or white) that contrasts it best — so you never hand-pick light/dark text
        for a dynamic background again. <code>AutoContrast.astro</code> wraps it with a JS luminance
        fallback so it works everywhere today.
      </p>
      <p class="sg_note">
        <strong>Support:</strong> native in Safari&nbsp;26+ and Firefox&nbsp;146+; Chrome/Edge fall back to the
        JS path. Both ship together via <code>@supports</code> (progressive enhancement) — see below.
      </p>

      <h4>Native CSS</h4>
      <pre><code>{acCssExample}</code></pre>

      <h4>The component (Astro)</h4>
      <pre><code>{acAstroExample}</code></pre>

      <h4>How the fallback is wired</h4>
      <pre><code>{acSupportExample}</code></pre>

      <h4>Live — text auto-adapts to each background</h4>
      <div class="sg_autocontrast">
        {autocontrastBgs.map((bg) => (
          <AutoContrast backgroundColor={bg} class="sg_ac_chip">{bg}</AutoContrast>
        ))}
      </div>
    </section>

    <p class="sg_foot"><code>src/pages/sty.astro</code> · tokens in <code>src/styles/layers/tokens.css</code></p>
  </main>
</Layout>

<style>
  .sg {
    max-width: var(--width_xl);
    padding-block: calc(var(--space_block) * 1.5);
  }

  .sg_head {
    padding-block-end: var(--space_block);
    border-bottom: 1px solid var(--blackT10);
  }
  .sg_lead {
    max-width: 60ch;
    color: var(--grey_color);
  }
  .sg_lead code,
  .sg_note code,
  .sg_body_sample code {
    background: #fff;
    padding: 0.1em 0.4em;
    border-radius: 6px;
    font-size: 0.9em;
  }

  /* In-page section nav — sticky on desktop only (not mobile). */
  .sg_nav {
    position: static;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--space_inline) / 2);
    margin-top: var(--space_block);
    padding-block: calc(var(--space_block) / 2);
    background: var(--region_main);
  }
  @media (min-width: 601px) {
    .sg_nav {
      position: sticky;
      top: 0;
    }
  }
  .sg_nav a {
    font-size: calc(var(--font_rem) * 0.8);
    font-weight: var(--weight_med);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: currentColor;
