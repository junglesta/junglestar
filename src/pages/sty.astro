---
// src/pages/sty.astro
// JUNGLESTAR STYLE SYSTEM
//
// Wave.astro component AND COLOR COMBOS
// AutoContrast.astro component
// COLORPICKER DEMO

import Layout from "@layouts/Layout.astro";
const title = "AutoContrast";
const description = "AutoContrast";

import WaveSection from "@components/UI/WaveSection.astro";
import AutoContrast from "@components/UI/AutoContrast.astro";
import "../styles/layers/tokens.css";

// Color tokens grouped to match the current single-source colour system
// (see COLOR.md): one --brand master → a derived --brand-50…900 scale, plus
// the harmonizer-tuned hue ramps in palette.css. Add a name to a group and
// the UI updates automatically.

// The single-source brand scale, derived from --brand via OKLCH relative colour
const brandScale = [
  "brand-50",
  "brand-100",
  "brand-200",
  "brand-300",
  "brand-400",
  "brand-500",
  "brand-600",
  "brand-700",
  "brand-800",
  "brand-900",
];

// Harmonizer-tuned hue ramps (palette.css): blue / green / orange at 100/500/675/1040
const paletteRamps = [
  "jstar-100",
  "jstar-500",
  "jstar-675",
  "jstar-1040",
  "jgreen-100",
  "jgreen-500",
  "jgreen-675",
  "jgreen-1040",
  "jorange-100",
  "jorange-500",
  "jorange-675",
  "jorange-1040",
];

// Neutrals: greys, whites, black (kept as-is)
const neutrals = [
  "black",
  "black_fumes",
  "whiteDIRTY",
  "whiteOFF",
  "white",
  "text_color",
  "grey_color_dark",
  "grey_color",
  "grey_color_light",
  "grey_color_lighter",
];

// All names, in display order — drives the wave demo and palette grids
const colorNames = [...brandScale, ...paletteRamps, ...neutrals];

// Generate color objects from names
const demoColors = colorNames.map((name) => ({
  var: `var(--${name})`,
  name: `--${name}`,
}));
---

<Layout
  title={title}
  description={description}
  bodyClass="ac"
>
  {
    colorNames.map((color, i) => (
      <WaveSection
        topBackground={`var(--${color})`}
        bottomBackground={`var(--${colorNames[(i + 1) % colorNames.length]})`}
        waveHeight={0.5}
        height="30svw"
      />
    ))
  }


  <div class="wrap">
    <div class="hero">
      <br />
      <br />
      <br />
      <br />
      <h1>Junglestar ✨Colour System</h1>
      <p>
        One <code>--brand</code> master (OKLCH) per page derives the whole
        <code>--brand-50…900</code> scale and the head / main / footer region
        ramp. AutoContrast then picks black or white text for any background
        via the native <code>contrast-color()</code> with a WCAG-luminance JS
        fallback.
      </p>
    </div>

    <div class="container">
      <!-- Interactive Demo Section -->
      <div class="featured-demo">
        <h2>Interactive Color Picker</h2>
        <p>
          Select any background color! The text color automatically switches
          between black and white to maintain optimal contrast and readability.
        </p>

        <AutoContrast
          backgroundColor="var(--jstar-100)"
          class="card wrap"
          id="interactive-card"
        >
          <h3>Auto Color Adjustment</h3>
          <span class="info-badge wrap">✓ WCAG Compliant</span>
          <p>
            This text adapts for perfect contrast! The component uses the WCAG
            2.1 relative luminance formula to determine whether black or white
            text provides better readability. It starts using:
            <code
              style="background: var(--whiteT25); padding: 0.2rem 0.5rem; border-radius: 4px;"
              >--jstar-100</code
            > in the OKLCH color space. <small
              ><br />After the fade-in offcourse.</small
            >
          </p>
        </AutoContrast>

        <div class="color-picker-wrapper center">
          <br />
          <br />
          <h3>Color Picker Demo</h3>
          <label for="colorPicker"><h4>Now, pick a Colour:</h4></label>
          <div class="color-picker-container">
            <input type="color" id="colorPicker" class="color-picker" />
            <div class="color-value" id="colorValue">Loading...</div>
          </div>
        </div>
      </div>

      <!-- Different HTML Tags Section -->
      <h2 class="section-title">AutoContrast Color Test</h2>
      <p class="section-subtitle">
        Works with any HTML tag using the 'tag' prop
      </p>

      <div class="tag-showcase">
        {
          demoColors.map((color) => (
            <AutoContrast
              backgroundColor={color.var}
              tag="section"
              class="mini-card"
            >
              <h3>{color.name}</h3>
            </AutoContrast>
          ))
        }
      </div>

      <!-- Color Palette Showcase -->
      <h2 class="section-title">Color Palette</h2>
      <p class="section-subtitle">
        The single-source <code>--brand-50…900</code> scale, the harmonizer
        ramps (<code>--jstar/--jgreen/--jorange</code> at 100/500/675/1040),
        and the neutrals — all in OKLCH with automatic contrast.
      </p>

      <h3 class="section-title">Brand scale (derived from <code>--brand</code>)</h3>
      <div class="demo-grid">
        {
          brandScale.map((name) => (
            <AutoContrast backgroundColor={`var(--${name})`} class="palette-card">
              <strong>--{name}</strong>
              <span class="var-name">var(--{name})</span>
            </AutoContrast>
          ))
        }
      </div>

      <h3 class="section-title">Harmonizer hue ramps</h3>
      <div class="demo-grid">
        {
          paletteRamps.map((name) => (
            <AutoContrast backgroundColor={`var(--${name})`} class="palette-card">
              <strong>--{name}</strong>
              <span class="var-name">var(--{name})</span>
            </AutoContrast>
          ))
        }
      </div>

      <h3 class="section-title">Neutrals</h3>
      <div class="demo-grid">
        {
          neutrals.map((name) => (
            <AutoContrast backgroundColor={`var(--${name})`} class="palette-card">
              <strong>--{name}</strong>
              <span class="var-name">var(--{name})</span>
            </AutoContrast>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Usage Example -->
  <div class="wrap">
    <h2>Quick Start</h2>
    <p style="color: var(--grey_color); margin-bottom: 1.5rem;">
      Using the AutoContrast component is simple:
    </p>
  </div>
  <pre
    style="background: var(--blackT15); padding: 1.5rem; border-radius: var(--radius); overflow-x: auto; color: var(--text_color); font-size: 0.9rem;"><code>import AutoContrast from "@components/UI/AutoContrast.astro";</code>
        </pre>
  <br />
  <pre
    style="background: var(--blackT15); padding: 1.5rem; border-radius: var(--radius); overflow-x: auto; color: var(--text_color); font-size: 0.9rem;"><code>&lt;AutoContrast backgroundColor="#0069cc"&gt;
  &lt;h2&gt;Your Content&lt;/h2&gt;
  &lt;p&gt;Text automatically contrasts!&lt;/p&gt;
&lt;/AutoContrast&gt;</code>
      </pre>

  <script>
    // Interactive color picker following Astro best practices
    // Astro scripts are bundled and run as type="module" automatically

    const colorPicker = document.getElementById(
      "colorPicker",
    ) as HTMLInputElement;
    const colorValue = document.getElementById("colorValue");
    const interactiveCard = document.getElementById("interactive-card") as any;

    // Helper function to convert RGB to hex
    function rgbToHex(rgb: string): string {
      const match = rgb.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
      if (!match) return "#000000";

      const r = parseInt(match[1]);
      const g = parseInt(match[2]);
      const b = parseInt(match[3]);

      return (
        "#" +
        [r, g, b]
          .map((x) => {
            const hex = x.toString(16);
            return hex.length === 1 ? "0" + hex : hex;
          })
          .join("")
      );
    }

    if (colorPicker && interactiveCard && colorValue) {
      // Get the computed background color and set it to the picker
      const computedBg =
        window.getComputedStyle(interactiveCard).backgroundColor;
      const hexColor = rgbToHex(computedBg);
      colorPicker.value = hexColor;
      colorValue.textContent = hexColor;

      // Listen for color changes
      colorPicker.addEventListener("input", (e) => {
        const color = (e.target as HTMLInputElement).value;

        // Update the displayed hex value
        colorValue.textContent = color;

        // Update the card's background color
        if (typeof interactiveCard.setBackgroundColor === "function") {
          interactiveCard.setBackgroundColor(color);
        }
      });
    } else {
      console.error("Color picker elements not found:", {
        colorPicker: !!colorPicker,
        interactiveCard: !!interactiveCard,
        colorValue: !!colorValue,
      });
    }
  </script>
</Layout>

<style>
  pre {
    margin-left: 1rem !important;
    min-width: 388px !important;
  }
</style>
