  .sg_body_sample { max-width: 62ch; }
  .sg_chips, .sg_buttons { display: flex; flex-wrap: wrap; gap: var(--space_inline); align-items: center; }

  .chip {
    position: relative;
    cursor: pointer;
    font: inherit;
    background: var(--blackT05);
    border: 1px solid var(--blackT10);
    border-radius: 999px;
    padding: 0.2em 0.7em;
    color: var(--grey_color);
  }
  .chip code { font-size: calc(var(--font_rem) * 0.72); }
  .chip:hover { background: var(--blackT10); }

  /* ── Spacing ── */
  .sg_space_list { display: flex; flex-direction: column; gap: calc(var(--space_block) / 2); }
  .sg_space_row {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space_inline);
    cursor: pointer;
    background: none;
    border: none;
