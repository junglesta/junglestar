    box-shadow: inset 0 0 0 1px var(--blackT10);
  }

  .sg_foot { margin-top: var(--space_block); color: var(--grey_color_light); font-size: calc(var(--font_rem) * 0.8); }
</style>

<style is:global>
  /* The global ::selection (bg: currentColor) goes invisible against this
     page's many surfaces — force a clear brand highlight here. */
  .styleguide ::selection {
    background: var(--brand);
    color: var(--white);
  }
</style>

<script>
  // Click-to-copy for every [data-copy] chip/swatch. Re-wires on view
  // transitions; guarded so handlers never stack.
  function initStyleguideCopy() {
    document.querySelectorAll<HTMLElement>("[data-copy]").forEach((el) => {
      if (el.dataset.copyWired) return;
      el.dataset.copyWired = "1";
      el.addEventListener("click", async () => {
        const value = el.getAttribute("data-copy");
        if (!value) return;
        try {
          await navigator.clipboard.writeText(value);
          el.classList.add("is-copied");
          setTimeout(() => el.classList.remove("is-copied"), 1200);
        } catch {
          /* clipboard unavailable — no-op */
        }
      });
    });
  }
  // Live readout of the current aspect-ratio tier's tokens.
  function updateAspectReadout() {
    const cs = getComputedStyle(document.documentElement);
    const l = document.getElementById("sg_landscape");
    const h = document.getElementById("sg_secheight");
    if (l) l.textContent = `--is_landscape: ${cs.getPropertyValue("--is_landscape").trim() || "0"}`;
    if (h) h.textContent = `--section_height: ${cs.getPropertyValue("--section_height").trim()}`;
  }

  document.addEventListener("astro:page-load", () => {
    initStyleguideCopy();
    updateAspectReadout();
  });
  window.addEventListener("resize", updateAspectReadout);
</script>
