---
//pages/w.astro
import Layout from "@layouts/Layout.astro";

import WaveSection from "@components/UI/WaveSection.astro";

export interface Props {
  bodyClass?: string;
  mainClass?: string;
  title: string;
  description?: string;
  sitemap?: boolean;
  pageSubtitle?: string;
}

const {
  bodyClass,
  mainClass = "",
  title,
  description = "Sustainable Web Design",
  sitemap = true,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  bodyClass="w bg_white"
  background="--white"
>
  <WaveSection
    topBackground="var(--brand_light)"
    bottomBackground="var(--brand_dark)"
    waveHeight={0.5}
    height="70px"
  />
</Layout>
